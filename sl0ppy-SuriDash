EOF

# ------------------------------------------------------------------------------
# TERMINAL CLEANUP & TRAPS
# ------------------------------------------------------------------------------
cleanup() {
    if [ "$INTERACTIVE" = "1" ]; then
        printf '\033[0m\033[?7h\033[?25h\033[?1049l'
        [ -n "$STTY_SAVE" ] && stty "$STTY_SAVE" 2>/dev/null
        printf '%s\n' "${GREEN}${BOLD}[+] Dashboard closed successfully.${NC}"
    fi
}
trap 'exit 130' INT
trap 'exit 143' TERM
trap cleanup EXIT

# ------------------------------------------------------------------------------
# HELPERS
# ------------------------------------------------------------------------------
safe_int() {
    if [[ "${1:-0}" =~ ^-?[0-9]+$ ]]; then printf '%s\n' "$1"; else printf '0\n'; fi
}

# Pure-bash formatters (no forks). Result in FMT_OUT.
num_commas() {
    local s="${1:-0}" neg="" out=""
    [[ "$s" =~ ^-?[0-9]+$ ]] || { FMT_OUT="$s"; return; }
    if [ "${s:0:1}" = "-" ]; then neg="-"; s="${s:1}"; fi
    while [ "${#s}" -gt 3 ]; do
        out=",${s: -3}${out}"
        s="${s:0:${#s}-3}"
    done
    FMT_OUT="${neg}${s}${out}"
}

bytes_h() {
    local b="${1:-0}" i=0 frac=0
    local -a units=(B KiB MiB GiB TiB PiB)
    [[ "$b" =~ ^[0-9]+$ ]] || b=0
    while [ "$b" -ge 1024 ] && [ "$i" -lt 5 ]; do
        frac=$(( (b % 1024) * 10 / 1024 ))
        b=$(( b / 1024 ))
        i=$(( i + 1 ))
    done
    if [ "$i" -eq 0 ]; then FMT_OUT="${b}B"; else FMT_OUT="${b}.${frac}${units[$i]}"; fi
}

fmt_num()   { num_commas "$1"; printf '%s' "$FMT_OUT"; }
fmt_bytes() { bytes_h "$1";    printf '%s' "$FMT_OUT"; }

fmt_uptime() {
    local s
    s="$(safe_int "$1")"
    printf '%dd %02dh %02dm %02ds' $((s/86400)) $((s%86400/3600)) $((s%3600/60)) $((s%60))
}

get_now_ms() {
    local t
    if [ -n "${EPOCHREALTIME:-}" ]; then
        t="${EPOCHREALTIME/[.,]/}"
        t="${t%???}"
        if [[ "$t" =~ ^[0-9]+$ ]]; then NOW_TS="$t"; return; fi
    fi
    t="$(date +%s%3N 2>/dev/null || true)"
    [[ "$t" =~ ^[0-9]+$ ]] || t="$(date +%s)000"
    NOW_TS="$t"
}

update_term_width() {
    local w
    w="$(tput cols 2>/dev/null || echo 100)"
    [[ "$w" =~ ^[0-9]+$ ]] || w=100
    [ "$w" -lt 96 ] && w=96
    [ "$w" -gt 140 ] && w=140
    TERM_W="$w"
}

sc_raw() {
    local command="${1:-}"
    [ -n "$command" ] || return 1
    if [ -n "${SOCKET:-}" ]; then
        suricatasc -c "$command" "$SOCKET" 2>/dev/null
    else
        suricatasc -c "$command" 2>/dev/null
    fi
}

sc_json() {
    local command="${1:-}" raw
    [ -n "$command" ] || return 1
    raw="$(sc_raw "$command")" || return 1
    [ -n "$raw" ] || return 1
    if printf '%s\n' "$raw" | jq -e . >/dev/null 2>&1; then
        printf '%s\n' "$raw"
        return 0
    fi
    # Older suricatasc builds print a python-style dict: convert it.
    if command -v python3 >/dev/null 2>&1; then
        printf '%s\n' "$raw" | python3 -c '
import sys, json, ast
data = sys.stdin.read().strip()
try:
    obj = json.loads(data)
except Exception:
    try:
        obj = ast.literal_eval(data)
    except Exception:
        sys.exit(1)
print(json.dumps(obj, separators=(",", ":")))
' 2>/dev/null && return 0
    fi
    return 1
}

# ------------------------------------------------------------------------------
# SOCKET DISCOVERY
# ------------------------------------------------------------------------------
discover_socket() {
    if [ -n "${SOCKET:-}" ]; then
        if [ -S "$SOCKET" ] && suricatasc -c version "$SOCKET" >/dev/null 2>&1; then
            SOCKET_STATUS="OK"; return 0
        fi
        SOCKET_STATUS="FAILED"; return 1
    fi

    if suricatasc -c version >/dev/null 2>&1; then
        SOCKET=""; SOCKET_STATUS="OK"; return 0
    fi

    local candidates=(
        "/run/suricata/suricata-command.socket"
        "/var/run/suricata/suricata-command.socket"
        "/run/suricata-command.socket"
        "/var/run/suricata-command.socket"
    )
    local candidate
    for candidate in "${candidates[@]}"; do
        [ -S "$candidate" ] || continue
        if suricatasc -c version "$candidate" >/dev/null 2>&1; then
            SOCKET="$candidate"; SOCKET_STATUS="OK"; return 0
        fi
    done

    while IFS= read -r candidate; do
        [ -S "$candidate" ] || continue
        if suricatasc -c version "$candidate" >/dev/null 2>&1; then
            SOCKET="$candidate"; SOCKET_STATUS="OK"; return 0
        fi
    done < <(find /run /var/run -type s \( -iname '*suricata*socket*' -o -iname '*command.socket' \) 2>/dev/null | head -n 20)

    SOCKET_STATUS="FAILED"
    return 1
}

get_suricata_version() {
    local data value
    data="$(sc_json version 2>/dev/null || true)"
    [ -n "$data" ] || { SURICATA_VERSION="UNKNOWN"; return; }
    value="$(printf '%s\n' "$data" | jq -r '
        def unwrap: if type == "object" and has("message") then .message else . end;
        unwrap |
        if type == "string" then .
        elif type == "object" then (.version // .suricata_version // .message // "UNKNOWN") | tostring
        else "UNKNOWN" end' 2>/dev/null | head -n 1)"
    SURICATA_VERSION="${value:-UNKNOWN}"
    [ -n "$SURICATA_VERSION" ] || SURICATA_VERSION="UNKNOWN"
}

# ------------------------------------------------------------------------------
# COUNTER PARSING
# ------------------------------------------------------------------------------
parse_counters() {
    local line k rest v alt
    while IFS= read -r line; do
        k="${line%%=*}"
        rest="${line#*=}"
        v="${rest%%;*}"
        alt="${rest#*;}"
        [[ "$k" =~ ^[A-Z0-9_]+$ ]] || continue

        if [ "$v" = "NA" ]; then
            # Not exposed by this build: show n/a, keep numeric value at 0.
            DV[$k]="n/a"; CTR_ALT[$k]="-"
            continue
        fi
        if ! [[ "$v" =~ ^-?[0-9]+$ ]]; then
            if [[ "$v" =~ ^-?[0-9.]+([eE][+-]?[0-9]+)?$ ]]; then
                v="$(awk -v x="$v" 'BEGIN { printf "%.0f", x }')"
            else
                continue
            fi
        fi
        printf -v "$k" '%s' "$v"
        CTR_ALT[$k]="$alt"
        case "$k" in
            FLOW_MEM_USE|FRAG_MEM_USE|TCP_MEMUSE|TCP_REASM_MEM) bytes_h "$v" ;;
            *) num_commas "$v" ;;
        esac
        DV[$k]="$FMT_OUT"
    done < <(printf '%s\n' "$1" | jq -r --arg map "$MAP_STR" "$JQ_COUNTERS" 2>/dev/null)
}

dump_keys() {
    printf '%s\n' "$1" | jq -r "$JQ_DUMP_KEYS" 2>/dev/null
}

check_report() {
    local entry k found=0 missing=0
    printf '%-20s %-18s %s\n' "COUNTER" "VALUE" "RESOLVED FROM"
    printf '%-20s %-18s %s\n' "-------" "-----" "-------------"
    for entry in "${COUNTER_MAP[@]}"; do
        k="${entry%%:*}"
        printf '%-20s %-18s %s\n' "$k" "${DV[$k]}" "${CTR_ALT[$k]}"
        if [ "${DV[$k]}" = "n/a" ]; then missing=$((missing+1)); else found=$((found+1)); fi
    done
    printf '\n%s counters resolved, %s not exposed by this Suricata build/config.\n' "$found" "$missing"
    printf 'n/a is normal for features you do not use (bypass, IPS verdicts, QUIC, ...).\n'
    printf 'Run with --debug-counters to see every key your build really exposes.\n'
}

get_rules_loaded() {
    local data value
    data="$(sc_json ruleset-stats 2>/dev/null || true)"
    if [ -n "$data" ]; then
        value="$(printf '%s\n' "$data" | jq -r "$JQ_FIND_RULES" 2>/dev/null)"
        if [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -gt 0 ]; then
            RULES_CACHE="$value"; RULES_LOADED="$value"; return
        fi
    fi
    if [ -n "$JSON_DATA" ]; then
        value="$(printf '%s\n' "$JSON_DATA" | jq -r "$JQ_FIND_RULES" 2>/dev/null)"
        if [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -gt 0 ]; then
            RULES_CACHE="$value"; RULES_LOADED="$value"; return
        fi
    fi
    RULES_LOADED="$RULES_CACHE"
}

sync_uptime() {
    local data value
    data="$(sc_json uptime 2>/dev/null || true)"
    [ -n "$data" ] || return
    value="$(printf '%s\n' "$data" | jq -r '
        def unwrap: if type == "object" and has("message") then .message else . end;
        unwrap |
        if type == "number" then .
        elif type == "string" then tonumber?
        elif type == "object" then (.uptime? // .seconds? // .value?)
        else null end' 2>/dev/null)"
    if [[ "$value" =~ ^[0-9]+$ ]]; then
        UPTIME_BASE="$value"
        UPTIME_BASE_TS="$NOW_TS"
    fi
}

resolve_uptime() {
    if [ "${UPTIME_C:-0}" -gt 0 ]; then
        UPTIME="$UPTIME_C"
    elif [ "$UPTIME_BASE_TS" -gt 0 ]; then
        UPTIME=$(( UPTIME_BASE + (NOW_TS - UPTIME_BASE_TS) / 1000 ))
    else
        UPTIME="$UPTIME_BASE"
    fi
}

get_other_protos() {
    OTHER_PROTOS=""
    [ -n "$JSON_DATA" ] || return
    OTHER_PROTOS=$(printf '%s\n' "$JSON_DATA" | jq -r --argjson ex "$FIXED_PROTOS" '
        (if has("message") then .message else . end)
        | (.app_layer.flow // {}) | to_entries
        | map(select((.value | type) == "number" and .value > 0
                     and ((.key | IN($ex[])) | not)
                     and ((.key | startswith("failed")) | not)))
        | sort_by(-.value) | .[]
        | "\(.key)\t\(.value | floor)"' 2>/dev/null)
}

show_other_protos() {
    if [ -z "$OTHER_PROTOS" ]; then
        printf '%s\n' "  ${DIM}(no uncommon protocols detected)${NC}"
        return
    fi
    printf '%s\n' "$OTHER_PROTOS" | awk -F'\t' -v max=18 '
        NF == 2 && n < max {
            n++
            if (n % 3 != 1) printf " |"
            printf " %-11.11s : \033[36m%-8.0f\033[0m", $1, $2
            if (n % 3 == 0) printf "\n"
        }
        NF == 2 { total++ }
        END {
            if (n > 0 && n % 3 != 0) printf "\n"
            if (total > max) printf "  ... +%d more\n", total - max
        }'
}

compute_effective() {
    if [ "${PKTS:-0}" -gt 0 ]; then
        EFF_PKTS="$PKTS"; PKT_SRC="decoder.pkts"
    else
        EFF_PKTS=$(( ${TCP_PKTS:-0} + ${UDP_PKTS:-0} + ${ICMP_PKTS:-0} + ${ARP_PKTS:-0} + ${IPV6_PKTS:-0} ))
        PKT_SRC="proto-sum"
    fi

    if [ "${BYTES:-0}" -gt 0 ]; then
        EFF_BYTES="$BYTES"; BYTE_SRC="decoder.bytes"
    else
        EFF_BYTES=0; BYTE_SRC="none"
    fi

    if [ "${TOTAL_FLOWS:-0}" -gt 0 ]; then
        EFF_FLOWS="$TOTAL_FLOWS"; FLOW_SRC="flow.total"
    else
        EFF_FLOWS=$(( ${F_TCP:-0} + ${F_UDP:-0} ))
        FLOW_SRC="flow.proto-sum"
    fi
}

# ------------------------------------------------------------------------------
# HEALTH ENGINE
#   100% = fully healthy. Problems are detected from per-cycle DELTAS of the
#   counters (lifetime totals never penalize) and stay active for
#   HEALTH_HOLD_S seconds so a problem seen at one stats tick is visible for
#   more than a single refresh. Recovery is automatic.
# ------------------------------------------------------------------------------
hp_bump() {   # name points text
    HP_UNTIL[$1]=$(( NOW_TS + HEALTH_HOLD_S * 1000 ))
    HP_PEN[$1]="$2"
    HP_TXT[$1]="${3:-$1}"
}

hp_active() { [ "${HP_UNTIL[$1]:-0}" -gt "$NOW_TS" ]; }

# True when counter $2 grew since the last call for key $1 (first call: false).
delta_pos() {
    local cur="${2:-0}" prev="${PH[$1]:-}"
    PH[$1]="$cur"
    [ -n "$prev" ] && [ "$cur" -gt "$prev" ]
}

compute_health() {
    local score=100 reasons="" name pen pct dd dp

    if [ "$SOCKET_STATUS" != "OK" ]; then
        HEALTH_PCT=0; HEALTH_REASONS="socket-offline; "
        return
    fi

    if [ "$PH_INIT" = "1" ]; then
        dd=$(( KERNEL_DROPS - PH_KD ))
        dp=$(( KERNEL_PKTS  - PH_KP ))
        if [ "$dd" -gt 0 ]; then
            read -r pen pct <<< "$(awk -v d="$dd" -v p="$dp" 'BEGIN {
                pct = (p > 0) ? d * 100 / p : 100
                if (pct > 100) pct = 100
                pen = int(pct + 0.999) * 6
                if (pen < 3) pen = 3
                if (pen > 30) pen = 30
                printf "%d %.2f", pen, pct }')"
            DROP_PCT_NOW="$pct"
            hp_bump capture-drop "$pen" "capture-drop ${pct}%"
        fi
    fi
    PH_KD="$KERNEL_DROPS"; PH_KP="$KERNEL_PKTS"; PH_INIT=1

    delta_pos flow-emergency       "$FLOW_EMERGENCY"  && hp_bump flow-emergency       20
    delta_pos flow-memcap          "$FLOW_MEMCAP"     && hp_bump flow-memcap          10
    delta_pos ssn-memcap-drop      "$MEMCAP_DROPS"    && hp_bump ssn-memcap-drop      10
    delta_pos segment-memcap-drop  "$SEG_MEMCAP"      && hp_bump segment-memcap-drop   5
    delta_pos frag-memcap          "$FRAG_MEMCAP"     && hp_bump frag-memcap           5
    delta_pos alert-queue-overflow "$DETECT_QUEUE"    && hp_bump alert-queue-overflow  5
    delta_pos app-layer-errors     "$AL_ERR"          && hp_bump app-layer-errors      3
    delta_pos frag-timeouts        "$FRAG_TIMEOUTS"   && hp_bump frag-timeouts         2
    delta_pos bad-checksums        "$TCP_BAD_CSUM"    && hp_bump bad-checksums         2

    for name in "${HP_ORDER[@]}"; do
        if hp_active "$name"; then
            score=$(( score - ${HP_PEN[$name]:-0} ))
            reasons+="${HP_TXT[$name]:-$name}; "
        fi
    done
    if [ "$COUNTER_RESETS" -gt 0 ]; then
        reasons+="counter-resets=${COUNTER_RESETS}; "
    fi

    [ "$score" -lt 0 ] && score=0
    [ "$score" -gt 100 ] && score=100
    HEALTH_PCT="$score"
    HEALTH_REASONS="$reasons"
}

set_health_color() {
    if [ "$HEALTH_PCT" -ge 90 ]; then HC="$GREEN"
    elif [ "$HEALTH_PCT" -ge 60 ]; then HC="$YELLOW"
    else HC="$RED"; fi
}

# ------------------------------------------------------------------------------
# RATE ENGINE
# ------------------------------------------------------------------------------
# Rolling peak for auto-scaling bars: rises instantly, decays 3/4 per cycle.
peak_roll() {   # $1 = current, $2 = peak, $3 = floor -> NEW_PEAK
    local cur="$1" peak="$2" floor="$3"
    if [ "$cur" -ge "$peak" ]; then
        peak="$cur"
    else
        peak=$(( (peak * 3 + cur) / 4 ))
        [ "$peak" -lt "$floor" ] && peak="$floor"
        [ "$cur" -gt "$peak" ] && peak="$cur"
    fi
    NEW_PEAK="$peak"
}

# Live NIC totals from /proc/net/dev. Always up to date, regardless of how
# often Suricata refreshes its stats snapshot.
read_iface_stats() {
    awk -v inc="$NIC_IFACES" '
        BEGIN { n = split(inc, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
        NR > 2 {
            line = $0; sub(/^[ \t]+/, "", line)
            name = line; sub(/:.*/, "", name)
            sub(/^[^:]*:/, "", line)
            split(line, f, " ")
            if (name == "lo") next
            if (n > 0 && !(name in want)) next
            if (n == 0 && name ~ /^(docker|veth|virbr|br-)/) next
            p += f[2] + f[10]; b += f[1] + f[9]
        }
        END { printf "%.0f %.0f\n", p, b }' /proc/net/dev 2>/dev/null || echo "0 0"
}

calculate_all_rates() {
    local changed=0 dt out np nm pr mb elapsed

    [ -r /proc/net/dev ] && NIC_OK=1 || NIC_OK=0
    read -r NIC_PKTS NIC_BYTES <<< "$(read_iface_stats)"
    NIC_PKTS="$(safe_int "$NIC_PKTS")"; NIC_BYTES="$(safe_int "$NIC_BYTES")"

    # ---- socket snapshot: did Suricata publish new numbers? -----------------
    if [ "$SNAP_TS" -eq 0 ]; then
        SNAP_TS="$NOW_TS"
    elif [ "$EFF_PKTS" -lt "$SNAP_PKTS" ] || [ "${ALERTS:-0}" -lt "$SNAP_ALERTS" ] \
         || [ "$PKT_SRC" != "$SNAP_PKT_SRC" ]; then
        COUNTER_RESETS=$(( COUNTER_RESETS + 1 ))     # restart / source change
        SNAP_TS="$NOW_TS"
    elif [ "$EFF_PKTS" != "$SNAP_PKTS" ] || [ "$EFF_BYTES" != "$SNAP_BYTES" ] \
         || [ "$EFF_FLOWS" != "$SNAP_FLOWS" ] || [ "${ALERTS:-0}" != "$SNAP_ALERTS" ] \
         || [ "${KERNEL_DROPS:-0}" != "$SNAP_DROPS" ]; then
        changed=1
    fi

    if [ "$changed" -eq 1 ]; then
        dt=$(( NOW_TS - SNAP_TS )); [ "$dt" -lt 1 ] && dt=1
        out="$(awk -v ms="$dt" \
            -v cp="$EFF_PKTS"  -v pp="$SNAP_PKTS" \
            -v cb="$EFF_BYTES" -v pb="$SNAP_BYTES" \
            -v cf="$EFF_FLOWS" -v pf="$SNAP_FLOWS" \
            -v ca="${ALERTS:-0}"       -v pa="$SNAP_ALERTS" \
            -v cd="${KERNEL_DROPS:-0}" -v pd="$SNAP_DROPS" '
            function r(c, p,   d) { d = c - p; return (d < 0) ? 0 : d / s }
            BEGIN {
                s = ms / 1000; if (s <= 0) s = 1
                printf "%.2f %.2f %.2f %.2f %.2f\n", r(cp, pp), r(cb, pb) * 8 / 1000000, \
                    r(cd, pd), r(ca, pa), r(cf, pf)
            }' 2>/dev/null)"
        if [ -n "$out" ]; then
            read -r SOCK_PPS SOCK_MBIT SOCK_DROPS SOCK_ALERTS SOCK_FLOWS <<< "$out"
        fi
        SOCK_UNTIL=$(( NOW_TS + 2 * dt + 1000 ))
        SNAP_TS="$NOW_TS"
    fi
    SNAP_PKTS="$EFF_PKTS"; SNAP_BYTES="$EFF_BYTES"; SNAP_FLOWS="$EFF_FLOWS"
    SNAP_ALERTS="${ALERTS:-0}"; SNAP_DROPS="${KERNEL_DROPS:-0}"; SNAP_PKT_SRC="$PKT_SRC"

    # Alerts / drops / flows rates: held until the next snapshot, then decay.
    if [ "$NOW_TS" -le "$SOCK_UNTIL" ]; then
        ALERT_RATE="$SOCK_ALERTS"; DROP_RATE="$SOCK_DROPS"; FLOW_RATE="$SOCK_FLOWS"
    else
        ALERT_RATE="0.00"; DROP_RATE="0.00"; FLOW_RATE="0.00"
    fi

    # ---- pps / Mbit/s: fresh socket data, else live NIC counters -----------
    RATE_SRC="socket"
    PKT_RATE="0.00"; MBIT_RATE="0.00"
    if [ "$changed" -eq 1 ] && awk -v a="$SOCK_PPS" -v b="$SOCK_MBIT" 'BEGIN { exit !(a+0 > 0 || b+0 > 0) }'; then
        PKT_RATE="$SOCK_PPS"; MBIT_RATE="$SOCK_MBIT"
    elif [ "$NIC_SEEN" -eq 1 ] && [ "$NIC_OK" -eq 1 ]; then
        elapsed=$(( NOW_TS - PREV_TS )); [ "$elapsed" -lt 50 ] && elapsed=1000
        out="$(awk -v ms="$elapsed" -v cp="$NIC_PKTS" -v pp="$NIC_PREV_PKTS" \
                   -v cb="$NIC_BYTES" -v pb="$NIC_PREV_BYTES" 'BEGIN {
            s = ms / 1000; if (s <= 0) s = 1
            dp = cp - pp; db = cb - pb
            if (dp < 0) dp = 0
            if (db < 0) db = 0
            printf "%.2f %.2f\n", dp / s, db * 8 / 1000000 / s }')"
        read -r np nm <<< "$out"
        PKT_RATE="${np:-0.00}"; MBIT_RATE="${nm:-0.00}"
        RATE_SRC="nic (/proc/net/dev)"
    elif [ "$NOW_TS" -le "$SOCK_UNTIL" ]; then
        PKT_RATE="$SOCK_PPS"; MBIT_RATE="$SOCK_MBIT"; RATE_SRC="socket (held)"
    fi
    NIC_PREV_PKTS="$NIC_PKTS"; NIC_PREV_BYTES="$NIC_BYTES"; NIC_SEEN=1

    if [ "${DEBUG_RATES:-0}" = "1" ]; then
        printf 'DEBUG changed=%s pkts=%s bytes=%s nic=%s/%s => pps=%s mbit=%s src=%s\n' \
            "$changed" "$EFF_PKTS" "$EFF_BYTES" "$NIC_PKTS" "$NIC_BYTES" \
            "$PKT_RATE" "$MBIT_RATE" "$RATE_SRC" >&2
    fi

    # Rolling peaks (hundredths) drive the auto-scaling bars.
    pr=$(( 10#${PKT_RATE/./} ))
    peak_roll "$pr" "$PEAK" 1;    PEAK="$NEW_PEAK"
    mb=$(( 10#${MBIT_RATE/./} ))
    peak_roll "$mb" "$PEAK_MB" 1; PEAK_MB="$NEW_PEAK"

    PREV_TS="$NOW_TS"
}

make_graph() {
    local val=$1 peak=$2 bars
    [ "$peak" -lt 1 ] && peak=1
    [ "$val" -lt 0 ] && val=0
    bars=$(( (val * GRAPH_MAX + peak / 2) / peak ))
    [ "$bars" -gt "$GRAPH_MAX" ] && bars=$GRAPH_MAX
    [ "$val" -gt 0 ] && [ "$bars" -lt 1 ] && bars=1
    printf '%s' "${BLOCK40:0:bars}${EMPTY40:0:GRAPH_MAX-bars}"
}

hund() { printf '%d.%02d' $(( $1 / 100 )) $(( $1 % 100 )); }

# Lifetime kernel drop ratio (informational). n/a if the capture method has no
# capture.* counters (e.g. NFQ).
kernel_drop_percent() {
    if [ "${DV[KERNEL_PKTS]}" = "n/a" ]; then printf 'n/a'; return; fi
    awk -v packets="${KERNEL_PKTS:-0}" -v drops="${KERNEL_DROPS:-0}" 'BEGIN {
        if (packets <= 0) { printf "0.00%%"; exit }
        p = (drops / packets) * 100
        if (p < 0) p = 0
        if (p > 100) p = 100
        printf "%.2f%%", p
    }'
}

alert_ratio() {
    awk -v packets="${EFF_PKTS:-0}" -v alerts="${ALERTS:-0}" 'BEGIN {
        if (packets <= 0) { printf "0.000%%"; exit }
        printf "%.3f%%", (alerts / packets) * 100
    }'
}

# ------------------------------------------------------------------------------
# EVE COLLECTION
# ------------------------------------------------------------------------------
collect_eve_stats() {
    local lines="${1:-$EVE_SAMPLE_LINES}"
    local line tag rest count name

    EVE_EVENTS=0; EVE_THREATS=0; EVE_INFO=0
    EVE_UNIQUE_SIGS=0; EVE_UNIQUE_SRC=0; EVE_UNIQUE_DST=0
    EVE_SEV1=0; EVE_SEV2=0; EVE_SEV3=0; EVE_SEV4=0; EVE_ANOMALY=0
    EVE_HTTP=0; EVE_TLS=0; EVE_DNS=0; EVE_FLOWS=0
    TOP_SIGS=""; TOP_SRC=""; TOP_DST=""; TOP_CATS=""; TOP_ISIGS=""
    TOP_HTTP=""; TOP_TLS=""; TOP_DNS=""

    [ -f "$EVE_LOG" ] || return 0

    EVE_DISPLAY_BYTES="$(stat -c '%s' "$EVE_LOG" 2>/dev/null || echo 0)"

    while IFS= read -r line; do
        tag="${line%%[ $'\t']*}"
        case "$tag" in
            AGG)
                rest="${line#* }"
                read -r EVE_EVENTS EVE_THREATS EVE_INFO EVE_UNIQUE_SIGS EVE_UNIQUE_SRC EVE_UNIQUE_DST \
                    EVE_SEV1 EVE_SEV2 EVE_SEV3 EVE_SEV4 EVE_ANOMALY EVE_HTTP EVE_TLS EVE_DNS EVE_FLOWS \
                    <<< "$rest"
                ;;
            SIG|SRC|DST|CAT|ISIG|HTTP|TLS|DNS)
                rest="${line#*$'\t'}"
                count="${rest%%$'\t'*}"
                name="${rest#*$'\t'}"
                case "$tag" in
                    SIG)  TOP_SIGS+="$count  $name"$'\n' ;;
                    SRC)  TOP_SRC+="$count  $name"$'\n' ;;
                    DST)  TOP_DST+="$count  $name"$'\n' ;;
                    CAT)  TOP_CATS+="$count  $name"$'\n' ;;
                    ISIG) TOP_ISIGS+="$count  $name"$'\n' ;;
                    HTTP) TOP_HTTP+="$count  $name"$'\n' ;;
                    TLS)  TOP_TLS+="$count  $name"$'\n' ;;
                    DNS)  TOP_DNS+="$count  $name"$'\n' ;;
                esac
                ;;
        esac
    done < <(tail -n "$lines" "$EVE_LOG" 2>/dev/null \
             | jq -R -r "$JQ_EVE_STREAM" 2>/dev/null \
             | awk -F'\t' "$AWK_EVE_AGG" 2>/dev/null)

    EVE_EVENTS="$(safe_int "$EVE_EVENTS")"
    EVE_THREATS="$(safe_int "$EVE_THREATS")"
    EVE_INFO="$(safe_int "$EVE_INFO")"
    EVE_UNIQUE_SIGS="$(safe_int "$EVE_UNIQUE_SIGS")"
    EVE_UNIQUE_SRC="$(safe_int "$EVE_UNIQUE_SRC")"
    EVE_UNIQUE_DST="$(safe_int "$EVE_UNIQUE_DST")"
    EVE_SEV1="$(safe_int "$EVE_SEV1")"
    EVE_SEV2="$(safe_int "$EVE_SEV2")"
    EVE_SEV3="$(safe_int "$EVE_SEV3")"
    EVE_SEV4="$(safe_int "$EVE_SEV4")"
    EVE_ANOMALY="$(safe_int "$EVE_ANOMALY")"
    EVE_HTTP="$(safe_int "$EVE_HTTP")"
    EVE_TLS="$(safe_int "$EVE_TLS")"
    EVE_DNS="$(safe_int "$EVE_DNS")"
    EVE_FLOWS="$(safe_int "$EVE_FLOWS")"
}

# ------------------------------------------------------------------------------
# ALERT COLLECTION
# ------------------------------------------------------------------------------
collect_recent_alerts() {
    local tsv="" line tag rest
    local c_red c_yel c_cyn c_mag c_dim c_rst maxw

    ALERT_HI=""; ALERT_INFO=""; CNT_HI=0; CNT_INFO=0; CNT_FP=0

    if [ -s "$EVE_LOG" ]; then
        tsv="$(tail -n "$ALERT_SCAN_LINES" "$EVE_LOG" 2>/dev/null \
               | grep -E '"event_type" *: *"alert"' \
               | tail -n "$ALERT_MAX_SCAN" \
               | jq -R -r --arg fp "$FP_REGEX" "$JQ_ALERT_TSV" 2>/dev/null)"
    fi
    if [ -z "$tsv" ] && [ -s "$FAST_LOG" ]; then
        tsv="$(tail -n "$ALERT_MAX_SCAN" "$FAST_LOG" 2>/dev/null \
               | awk -v fp="$FP_REGEX" "$AWK_FASTLOG" 2>/dev/null)"
    fi
    [ -n "$tsv" ] || return 0

    c_red=$'\033[1;31m'; c_yel=$'\033[33m'; c_cyn=$'\033[36m'
    c_mag=$'\033[35m';   c_dim=$'\033[2m';  c_rst=$'\033[0m'
    maxw=$(( TERM_W - 4 ))

    while IFS= read -r line; do
        tag="${line%%$'\t'*}"
        rest="${line#*$'\t'}"
        case "$tag" in
            H) ALERT_HI+="$rest"$'\n' ;;
            I) ALERT_INFO+="$rest"$'\n' ;;
            C) IFS=$'\t' read -r CNT_HI CNT_INFO CNT_FP <<< "$rest" ;;
        esac
    done < <(printf '%s\n' "$tsv" | awk -F'\t' \
                -v boxn="$ALERT_BOX_LINES" -v maxw="$maxw" \
                -v fphide="$FP_HIDE" -v label="$FP_LABEL" \
                -v red="$c_red" -v yel="$c_yel" -v cyn="$c_cyn" \
                -v mag="$c_mag" -v dim="$c_dim" -v rst="$c_rst" \
                "$AWK_ALERTS" 2>/dev/null)

    CNT_HI="$(safe_int "$CNT_HI")"
    CNT_INFO="$(safe_int "$CNT_INFO")"
    CNT_FP="$(safe_int "$CNT_FP")"
}

# ------------------------------------------------------------------------------
# DISPLAY HELPERS  (printf '%s' everywhere: data is never interpreted)
# ------------------------------------------------------------------------------
# row "Label:" "value" "$COLOR"  [x3]   -> one aligned line of up to 3 cells
row() {
    local out="" piece
    while [ $# -ge 3 ]; do
        printf -v piece '%s%-15s%s%-15s%s' "$WHITE" "$1" "$3" "$2" "$NC"
        out+="$piece"
        shift 3
    done
    printf '  %s\n' "$out"
}

section() { printf '\n%s\n' "${MAGENTA}${BOLD}  [ $1 ]${NC}"; }

print_top_list() {
    local data="${1:-}" empty_msg="${2:-(no data in current EVE sample)}" line
    if [ -n "$data" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            printf '    %s\n' "$line"
        done <<< "$data"
    else
        printf '    %s\n' "${DIM}${empty_msg}${NC}"
    fi
}

show_alert_box() {
    local title="$1" color="$2" data="$3" empty_msg="$4"
    local width fill line
    width=$(( TERM_W - 5 - ${#title} ))
    [ "$width" -lt 3 ] && width=3
    printf -v fill '%*s' "$width" ''
    fill="${fill// /─}"
    printf '%s\n' "${color}${BOLD}┌─ ${title} ${fill}${NC}"
    if [ -n "$data" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            printf '%s\n' "${color}│${NC} ${line}${NC}"
        done <<< "$data"
    else
        printf '%s\n' "${color}│${NC} ${DIM}${empty_msg}${NC}"
    fi
    printf -v fill '%*s' "$(( TERM_W - 2 ))" ''
    fill="${fill// /─}"
    printf '%s\n' "${color}└${fill}${NC}"
}

show_alert_boxes() {
    local fp_note=""
    if [ "$CNT_FP" -gt 0 ]; then
        fp_note=" | ${FP_LABEL^^} tagged: ${CNT_FP}$([ "$FP_HIDE" = "1" ] && echo ' (hidden)')"
    fi

    printf '%s\n' "${CYAN}${BOLD}[+] Realtime Alert Monitor (last ${ALERT_MAX_SCAN} alert events scanned${fp_note})${NC}"

    if [ -n "$ALERT_HI" ]; then
        show_alert_box "REAL THREATS - MEDIUM / HIGH  (${CNT_HI} in window)" "$RED" "$ALERT_HI" ""
    else
        printf '%s\n' "${GREEN}${BOLD}  ✔ No medium/high threats in the recent window${NC}"
    fi
}

show_info_box() {
    printf '\n'
    show_alert_box "ET INFORMATIONAL / LOW  (${CNT_INFO} in window)" \
        "$CYAN" "$ALERT_INFO" "(no informational alerts in the recent window)"
}

show_eve_stats() {
    local eve_size

