DEBUG_RATES="${DEBUG_RATES:-0}"
DEBUG_PARSE="${DEBUG_PARSE:-0}"
ONCE=0
CHECK_MODE=0

usage() {
    cat <<EOF
sl0ppy Suricata Dashboard ${Suridash_Version}

Usage: sudo $0 [options]

  -i, --interval SEC    refresh interval in seconds (default ${REFRESH_INTERVAL})
      --once            print one frame and exit (no interactive UI)
      --check           list every counter, its value and the stats key it
                        resolved from (verifies the mapping on your build)
      --debug-counters  dump every numeric key your Suricata exposes
      --debug-parse     show the raw dump-counters reply, jq errors and the
                        parsed counter lines (diagnoses counters stuck at 0)
  -V, --version         print version
  -h, --help            this help

Keys:  q quit | p pause | r refresh | j/k or arrows scroll | PgUp/PgDn,
       space/b page | g top | G bottom

Environment: REFRESH_INTERVAL FAST_LOG EVE_LOG SURICATA_SOCKET NIC_IFACES
  EVE_SAMPLE_LINES EVE_SAMPLE_LINES_HIGH HIGH_LOAD_PPS EVE_REFRESH_EVERY
  SLOW_REFRESH_EVERY ALERT_SCAN_LINES ALERT_MAX_SCAN ALERT_BOX_LINES
  FP_LABEL FP_REGEX FP_HIDE HEALTH_HOLD_S RATE_DECAY DEBUG_RATES
  HW_TEMP_WARN HW_TEMP_CRIT SMART_ENABLED IPMI_ENABLED
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)        usage; exit 0 ;;
        -V|--version)     echo "Suridash ${Suridash_Version}"; exit 0 ;;
        -i|--interval)    [ $# -ge 2 ] || { echo "[-] $1 needs a value" >&2; exit 1; }
                          REFRESH_INTERVAL="$2"; shift ;;
        --once)           ONCE=1 ;;
        --check)          CHECK_MODE=1 ;;
        --debug-counters) DEBUG_COUNTERS=1 ;;
        --debug-parse)    DEBUG_PARSE=1 ;;
        *) echo "[-] Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

# ------------------------------------------------------------------------------
# ROOT CHECK
# ------------------------------------------------------------------------------
if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    printf '%s\n' "${RED}[-] This dashboard requires root privileges (sudo).${NC}"
    exit 1
fi

for _v in EVE_SAMPLE_LINES EVE_SAMPLE_LINES_HIGH HIGH_LOAD_PPS EVE_REFRESH_EVERY \
          SLOW_REFRESH_EVERY ALERT_SCAN_LINES ALERT_MAX_SCAN ALERT_BOX_LINES \
          REFRESH_INTERVAL HEALTH_HOLD_S HW_TEMP_WARN HW_TEMP_CRIT; do
    if ! [[ "${!_v}" =~ ^[1-9][0-9]*$ ]]; then
        printf '%s\n' "${RED}[-] ${_v} must be a positive integer (got: '${!_v}').${NC}"
        exit 1
    fi
done
[[ "$FP_HIDE" =~ ^[01]$ ]] || FP_HIDE=0
[[ "$SMART_ENABLED" =~ ^[01]$ ]] || SMART_ENABLED=1
[[ "$IPMI_ENABLED" =~ ^[01]$ ]] || IPMI_ENABLED=1
awk -v x="$RATE_DECAY" 'BEGIN { if (x <= 0 || x >= 1) exit 1 }' || RATE_DECAY="0.75"

# ------------------------------------------------------------------------------
# DEPENDENCY CHECK
# ------------------------------------------------------------------------------
MISSING=()
for cmd in jq suricatasc awk sed tail tput date stat sort grep find; do
    command -v "$cmd" >/dev/null 2>&1 || MISSING+=("$cmd")
done
if [ "${#MISSING[@]}" -gt 0 ]; then
    printf '%s\n' "${RED}[-] Missing dependencies:${NC}"
    printf '    - %s\n' "${MISSING[@]}"
    printf '\n%s\n' "${YELLOW}[!] Install requirements:${NC} apt install jq suricata coreutils ncurses-bin"
    exit 1
fi

