    row "TCP SYN:" "${DV[TCP_SYN]}$(dd TCP_SYN)" "$CYAN" "TCP SYNACK:" "${DV[TCP_SYNACK]}$(dd TCP_SYNACK)" "$CYAN" "TCP RST:" "${DV[TCP_RST]}$(dd TCP_RST)" "$CYAN"
    row "TCP active:" "${DV[TCP_ACTIVE]}$(dd TCP_ACTIVE)" "$CYAN" "TCP sessions:" "${DV[TCP_SESS]}$(dd TCP_SESS)" "$CYAN" "Midstream:" "${DV[STREAM_MIDSTREAM]}$(dd STREAM_MIDSTREAM)" "$CYAN"
    row "SSN drop:" "${DV[MEMCAP_DROPS]}$(dd MEMCAP_DROPS)" "$YELLOW" "Segment drop:" "${DV[SEG_MEMCAP]}$(dd SEG_MEMCAP)" "$YELLOW" "Seg. cache:" "${DV[SEG_CACHE]}" "$CYAN"
    row "TCP mem:" "${DV[TCP_MEMUSE]}" "$CYAN" "Reasm. mem:" "${DV[TCP_REASM_MEM]}" "$CYAN" "Reasm. gaps:" "${DV[TCP_REASM_GAP]}$(dd TCP_REASM_GAP)" "$YELLOW"

    section "IPS & FLOW BYPASS"
