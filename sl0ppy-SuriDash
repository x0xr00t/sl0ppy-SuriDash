# ------------------------------------------------------------------------------
# CYCLE: collect everything and build the next frame
# ------------------------------------------------------------------------------
set_frame() {
    local t
    FRAME="$1"
    t="${FRAME//[^$'\n']/}"
    FRAME_LINES=$(( ${#t} + 1 ))
}

collect_cycle() {
    CYCLE=$(( CYCLE + 1 ))
    get_now_ms

    if [ "$SOCKET_STATUS" != "OK" ]; then
        discover_socket && get_suricata_version
    fi
    if [ "$SOCKET_STATUS" = "OK" ]; then
        JSON_DATA="$(sc_json dump-counters 2>/dev/null || true)"
        get_now_ms
        [ -n "$JSON_DATA" ] || SOCKET_STATUS="FAILED"
    fi
    if [ "$SOCKET_STATUS" != "OK" ]; then
        update_term_width
        set_frame "$(show_connection_error)"
        return 1
    fi

    parse_counters "$JSON_DATA"
    compute_effective
    calculate_all_rates
    update_term_width
    compute_health
    hw_collect_quick

    # Track whether Suricata is counting at all (decoder stays at 0?)
    if [ "$EFF_PKTS" -eq 0 ] && [ "$ZERO_CYCLES" -ge 0 ]; then
        ZERO_CYCLES=$(( ZERO_CYCLES + 1 ))
        [ "$ZERO_CYCLES" -eq 2 ] && { read_suricata_yaml; read_eve_age; }
        [ "$ZERO_CYCLES" -gt 2 ] && [ $(( ZERO_CYCLES % 5 )) -eq 0 ] && read_eve_age
    else
        ZERO_CYCLES=0
    fi

    if [ "$(safe_int "${PKT_RATE%.*}")" -gt "$HIGH_LOAD_PPS" ]; then
        LOAD_LABEL="HIGH LOAD"
        ACTIVE_EVE_LINES="$EVE_SAMPLE_LINES_HIGH"
    else
        LOAD_LABEL="NORMAL"
        ACTIVE_EVE_LINES="$EVE_SAMPLE_LINES"
    fi

    if [ "$FORCE_REFRESH" = "1" ] \
       || [ $(( NOW_TS - LAST_EVE_TS )) -ge $(( EVE_REFRESH_EVERY * REFRESH_INTERVAL * 1000 )) ]; then
        collect_eve_stats "$ACTIVE_EVE_LINES"
        EVE_DISPLAY_SAMPLE="$ACTIVE_EVE_LINES"
        collect_recent_alerts
        LAST_EVE_TS="$NOW_TS"
    fi
    if [ "$FORCE_REFRESH" = "1" ] \
       || [ $(( NOW_TS - LAST_SLOW_TS )) -ge $(( SLOW_REFRESH_EVERY * REFRESH_INTERVAL * 1000 )) ]; then
        get_rules_loaded
        [ "${UPTIME_C:-0}" -gt 0 ] || sync_uptime
        hw_collect_deep
        LAST_SLOW_TS="$NOW_TS"
    fi
    FORCE_REFRESH=0
    resolve_uptime
    get_other_protos

    set_frame "$(render_frame)"
    return 0
}

# ------------------------------------------------------------------------------
# INTERACTIVE DISPLAY
# ------------------------------------------------------------------------------
draw() {
    local rows body maxoff status
    rows="$(tput lines 2>/dev/null || echo 40)"
    [[ "$rows" =~ ^[0-9]+$ ]] || rows=40
    body=$(( rows - 1 )); [ "$body" -lt 5 ] && body=5
    maxoff=$(( FRAME_LINES - body )); [ "$maxoff" -lt 0 ] && maxoff=0
    [ "$OFFSET" -gt "$maxoff" ] && OFFSET="$maxoff"
    [ "$OFFSET" -lt 0 ] && OFFSET=0

    status=" q quit | p pause | r refresh | j/k PgUp/PgDn g/G scroll | lines $((OFFSET+1))-$(( OFFSET+body > FRAME_LINES ? FRAME_LINES : OFFSET+body ))/${FRAME_LINES}"
    [ "$PAUSED" = "1" ] && status+=" | PAUSED"

    printf '\033[H'
    printf '%s\n' "$FRAME" | awk -v a=$((OFFSET+1)) -v b=$((OFFSET+body)) \
        'NR >= a && NR <= b { printf "%s\033[K\n", $0 }'
    printf '\033[J\033[%d;1H%s%s%s\033[K' "$rows" "$REV" "$status" "$NC"
}

# Wait up to REFRESH_INTERVAL for the next cycle while serving key presses.
wait_for_input() {
    local deadline remain t key rest rows body
    get_now_ms
    deadline=$(( NOW_TS + REFRESH_INTERVAL * 1000 ))
    while true; do
        get_now_ms
        remain=$(( deadline - NOW_TS ))
        if [ "$PAUSED" = "0" ] && [ "$remain" -le 0 ]; then return; fi
        [ "$remain" -lt 50 ] && remain=200
        if [ -t 0 ]; then
            printf -v t '%d.%03d' $(( remain / 1000 )) $(( remain % 1000 ))
            key=""
            if read -rsn1 -t "$t" key; then
                if [ "$key" = $'\e' ]; then
                    read -rsn2 -t 0.02 rest || rest=""
                    case "$rest" in
                        "[A") key="k" ;;
                        "[B") key="j" ;;
                        "[5") key="PGUP" ;;
                        "[6") key="PGDN" ;;
                        "[H") key="g" ;;
                        "[F") key="G" ;;
                        *)    key="" ;;
                    esac
                fi
                rows="$(tput lines 2>/dev/null || echo 40)"; body=$(( rows - 2 ))
                case "$key" in
                    q|Q) exit 0 ;;
                    p|P) if [ "$PAUSED" = "1" ]; then PAUSED=0; return; else PAUSED=1; draw; fi ;;
                    r|R) FORCE_REFRESH=1; PAUSED=0; return ;;
                    j)   OFFSET=$(( OFFSET + 1 )); draw ;;
                    k)   OFFSET=$(( OFFSET - 1 )); draw ;;
                    PGDN|" ") OFFSET=$(( OFFSET + body )); draw ;;
                    PGUP|b)   OFFSET=$(( OFFSET - body )); draw ;;
                    g)   OFFSET=0; draw ;;
                    G)   OFFSET=999999; draw ;;
                esac
            fi
        else
            sleep "$(( remain / 1000 + 1 ))"
            [ "$PAUSED" = "1" ] || return
        fi
    done
}

# ------------------------------------------------------------------------------
# STARTUP
# ------------------------------------------------------------------------------
discover_socket
[ "$SOCKET_STATUS" = "OK" ] && get_suricata_version
get_now_ms
update_term_width
hw_detect_platform
hw_collect_quick
hw_collect_deep

# ---- diagnostic modes ----------------------------------------------------------
if [ "$DEBUG_PARSE" = "1" ]; then
    if [ "$SOCKET_STATUS" != "OK" ]; then
        show_connection_error
        exit 1
    fi
    JSON_DATA="$(sc_json dump-counters 2>/dev/null || true)"
    if [ -z "$JSON_DATA" ]; then
        printf '%s\n' "${RED}[-] dump-counters returned nothing (sc_json failed).${NC}"
        printf '%s\n' "    Raw suricatasc reply:"
        sc_raw dump-counters 2>/dev/null | head -n 20
        exit 1
    fi
    printf '%s\n' "${CYAN}${BOLD}=== 1. raw dump-counters reply (first 25 lines) ===${NC}"
    printf '%s\n' "$JSON_DATA" | head -n 25
    printf '%s\n' "${CYAN}${BOLD}=== 2. jq version ===${NC}"
    jq --version 2>/dev/null || echo "jq --version not supported (very old jq!)"
    printf '%s\n' "${CYAN}${BOLD}=== 3. jq errors (if any) ===${NC}"
    printf '%s\n' "$JSON_DATA" | jq -r --arg map "$MAP_STR" "$JQ_COUNTERS" >/dev/null
    printf '%s\n' "${CYAN}${BOLD}=== 4. parsed counter lines (first 25) ===${NC}"
    parse_counters "$JSON_DATA"
    printf '%s\n' "$JSON_DATA" | jq -r --arg map "$MAP_STR" "$JQ_COUNTERS" 2>/dev/null | head -n 25
    printf '%s\n' "${CYAN}${BOLD}=== 5. result ===${NC}"
    printf '%s\n' "resolved: $STATS_RESOLVED   not exposed (n/a): $STATS_NA"
    if [ "$STATS_RESOLVED" -eq 0 ]; then
        printf '%s\n' "${RED}[-] No counters parsed. If section 1 shows real stats but section 3"
        printf '%s\n' "   shows a jq error, your jq is too old for this template (need >= 1.5)."
        printf '%s\n' "   If section 1 is nearly empty, Suricata has no unix-command socket"
        printf '%s\n' "   stats: enable unix-command in suricata.yaml and restart suricata.${NC}"
    else
        printf '%s\n' "${GREEN}[+] Counter pipeline works on this box.${NC}"
    fi
    exit 0
fi

if [ "$DEBUG_COUNTERS" = "1" ] || [ "$CHECK_MODE" = "1" ]; then
    if [ "$SOCKET_STATUS" != "OK" ]; then
        show_connection_error
        exit 1
    fi
    JSON_DATA="$(sc_json dump-counters 2>/dev/null || true)"
    if [ -z "$JSON_DATA" ]; then
        printf '%s\n' "${RED}[-] dump-counters returned nothing.${NC}"
        exit 1
    fi
    if [ "$DEBUG_COUNTERS" = "1" ]; then
        dump_keys "$JSON_DATA"
    else
        parse_counters "$JSON_DATA"
        check_report
    fi
    exit 0
fi

# ---- single frame ---------------------------------------------------------------
[ -t 1 ] || ONCE=1
if [ "$ONCE" = "1" ]; then
    collect_cycle
    if [ "$SOCKET_STATUS" = "OK" ]; then
        sleep 2                # second sample gives the rates / deltas a baseline
        collect_cycle
    fi
    printf '%s\n' "$FRAME"
    exit 0
fi

# ---- interactive ---------------------------------------------------------------
INTERACTIVE=1
STTY_SAVE="$(stty -g 2>/dev/null || true)"
printf '\033[?1049h\033[?7l\033[?25l\033[2J'

