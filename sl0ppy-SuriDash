#!/bin/bash
# ==============================================================================
# sl0ppy Suricata Network Security & Threat Intelligence Dashboard  (v1.1)
# Author : Patrick Hoogeven x0xr00t 
# Build  : 07042026
# Name   : SuriDash
# Veraion: v1.1 
# ==============================================================================
# Read-only: nothing in the Suricata configuration is ever modified.
#
# v1.1 changes:
#   COUNTERS
#     * Every counter key re-audited against the Suricata 7/8 stats tree:
#         - active flows  -> flow.active          (flow.tcp/udp are CUMULATIVE)
#         - active TCP    -> tcp.active_sessions  (tcp.sessions is cumulative)
#         - total flows   -> flow.total
#         - flow end state-> flow.end.state.* / flow.mgr.*_pruned
#         - bypass        -> flow_bypassed.local_pkts / local_capture_pkts / pkts
#         - app errors    -> SUM of app_layer.error.*.{parser,alloc,internal}
#                            (app_layer.error is an OBJECT, v7.2 read it as 0)
#         - invented counters (ips.malware_blocked, ips.active_dropped ...)
#           removed.
#     * Wildcard paths ("a.*.b") and object-sum lookups in the jq engine.
#     * Counters your build does NOT expose now show "n/a" instead of a
#       misleading 0.
#     * --check prints every counter, its value and the exact stats key it was
#       resolved from, so you can verify the mapping against YOUR build.
#   RATES
#     * Socket rates are computed over the real time between stats snapshots
#       (Suricata only refreshes dump-counters every stats-interval) and held
#       until the next snapshot; pps / Mbit/s fall back to live NIC counters
#       (/proc/net/dev) between ticks, so the bars always move.
#     * NIC_IFACES="eth1 eth2" restricts the NIC fallback to the sniffing /
#       bridge interfaces (default: everything except lo/docker/veth/virbr/br-).
#     * awk output uses %.0f (mawk's %d overflows above 2^31).
#   HEALTH
#     * Penalties come from per-cycle deltas and are held for HEALTH_HOLD_S
#       seconds (default 30), so a problem seen at one stats tick stays visible
#       instead of flickering for a single refresh. First sample is a baseline
#       (no false penalty from lifetime totals). Capture-drop penalty uses the
#       drop ratio of the LAST interval, not lifetime.
#   UI
#     * Flicker-free redraw (alternate screen, cursor-home, no full clear).
#     * Scrolling for frames taller than the terminal: j/k, arrows, PgUp/PgDn,
#       space/b, g/G.  p = pause, r = refresh now, q = quit.
#     * Data is never passed through echo -e (signature text containing
#       backslashes can no longer corrupt the display).
#     * --once prints a single frame (cron / testing / screenshots).
#     * EVE/slow refresh are time based, not cycle based.
#
# Usage:  sudo ./suridash.sh [-i SECONDS] [--once] [--check] [--debug-counters]
#         sudo ./suridash.sh --help
# ==============================================================================

set -u

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    echo "[-] bash >= 4 is required." >&2
    exit 1
fi

if [ -n "${LC_ALL:-}" ]; then export LANG="$LC_ALL"; unset LC_ALL; fi
export LC_NUMERIC=C

Suridash_Version="v1.1"

