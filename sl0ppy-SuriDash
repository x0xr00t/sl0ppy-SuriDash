    ep(.dest_ip; .dest_port),
    ((.proto // "") | san),
    (if ($fp != "") and (try ($hay | test($fp; "i")) catch false) then "FP" else "-" end),
    (if is_info then "I" else "T" end)
  ]
| @tsv
EOF

read -r -d '' AWK_FASTLOG <<'EOF'
{
    gsub(/\033\[[0-9;]*m/, "")
    n = split($0, p, / *\[\*\*\] */)
    if (n < 3) next
    ts = p[1]; sub(/^[^-]*-/, "", ts); sub(/\..*/, "", ts)
    sid = ""; sig = p[2]
    if (match(p[2], /^\[[0-9]+:[0-9]+:[0-9]+\]/)) {
        split(substr(p[2], RSTART + 1, RLENGTH - 2), q, ":")
        sid = q[2]
        sig = substr(p[2], RLENGTH + 2)
    }
    pri = 3
    if (match(p[3], /Priority: [0-9]+/)) pri = substr(p[3], RSTART + 10, RLENGTH - 10)
    proto = ""; src = "?"; dst = "?"
    if (match(p[3], /\{[A-Za-z0-9_]+\}/)) {
        proto = substr(p[3], RSTART + 1, RLENGTH - 2)
        rest = substr(p[3], RSTART + RLENGTH + 1)
        if (split(rest, e, " -> ") == 2) { src = e[1]; dst = e[2] }
    }
    gsub(/[^ -~]/, "?", sig)
    fpf = "-"
    if (fp != "" && tolower($0) ~ tolower(fp)) fpf = "FP"
    cls = "T"
    if (toupper(sig) ~ /^ET INFO/ || (pri + 0) >= 3) cls = "I"
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", pri, ts, sid, sig, src, dst, proto, fpf, cls
}
EOF

read -r -d '' AWK_ALERTS <<'EOF'
BEGIN { FS = "\t"; label = toupper(label) }
{
    sev = $1 + 0; tm = $2; sid = $3; sig = $4; src = $5; dst = $6; proto = $7
    fp = ($8 == "FP"); cls = $9
    if (fp) { fpn++; if (fphide) next }
    line = tm " "
    if (fp) line = line "[" label "] "
    line = line "S" sev " "
    if (sid != "") line = line "[" sid "] "
    line = line sig "  " proto " " src " -> " dst
    if (length(line) > maxw) line = substr(line, 1, maxw - 3) "..."
    if (cls == "I") {
        if (fp) col = mag; else if (sev == 3) col = cyn; else col = dim
        ln++; iq[ln] = col line rst
    } else {
        if (fp) col = mag; else if (sev == 1) col = red; else col = yel
        hn++; hq[hn] = col line rst
    }
}
END {
    for (i = (hn > boxn ? hn - boxn + 1 : 1); i <= hn; i++) print "H\t" hq[i]
    for (i = (ln > boxn ? ln - boxn + 1 : 1); i <= ln; i++) print "I\t" iq[i]
    printf "C\t%d\t%d\t%d\n", hn + 0, ln + 0, fpn + 0
