# ------------------------------------------------------------------------------
# HEALTH ENGINE
#   100% = fully healthy. Problems are detected from per-cycle DELTAS of the
#   counters (lifetime totals never penalize) and stay active for
#   HEALTH_HOLD_S seconds so a problem seen at one stats tick is visible for
#   more than a single refresh. Recovery is automatic.
# ------------------------------------------------------------------------------
hp_bump() {   # name points text
    HP_UNTIL[$1]=$(( NOW_TS + HEALTH_HOLD_S * 1000 ))
    HP_PEN[$1]="$2"
    HP_TXT[$1]="${3:-$1}"
}

hp_active() { [ "${HP_UNTIL[$1]:-0}" -gt "$NOW_TS" ]; }

# True when counter $2 grew since the last call for key $1 (first call: false).
delta_pos() {
    local cur="${2:-0}" prev="${PH[$1]:-}"
    PH[$1]="$cur"
    [ -n "$prev" ] && [ "$cur" -gt "$prev" ]
}

compute_health() {
    local score=100 reasons="" name pen pct dd dp

    if [ "$SOCKET_STATUS" != "OK" ]; then
        HEALTH_PCT=0; HEALTH_REASONS="socket-offline; "
        return
    fi

    if [ "$PH_INIT" = "1" ]; then
        dd=$(( KERNEL_DROPS - PH_KD ))
        dp=$(( KERNEL_PKTS  - PH_KP ))
        if [ "$dd" -gt 0 ]; then
            read -r pen pct <<< "$(awk -v d="$dd" -v p="$dp" "$AWK_HPDROP")"
            DROP_PCT_NOW="$pct"
            hp_bump capture-drop "$pen" "capture-drop ${pct}%"
        fi
    fi
    PH_KD="$KERNEL_DROPS"; PH_KP="$KERNEL_PKTS"; PH_INIT=1

    delta_pos flow-emergency       "$FLOW_EMERGENCY"  && hp_bump flow-emergency       20
    delta_pos flow-memcap          "$FLOW_MEMCAP"     && hp_bump flow-memcap          10
    delta_pos ssn-memcap-drop      "$MEMCAP_DROPS"    && hp_bump ssn-memcap-drop      10
    delta_pos segment-memcap-drop  "$SEG_MEMCAP"      && hp_bump segment-memcap-drop   5
    delta_pos frag-memcap          "$FRAG_MEMCAP"     && hp_bump frag-memcap           5
    delta_pos alert-queue-overflow "$DETECT_QUEUE"    && hp_bump alert-queue-overflow  5
    delta_pos app-layer-errors     "$AL_ERR"          && hp_bump app-layer-errors      3
    delta_pos frag-timeouts        "$FRAG_TIMEOUTS"   && hp_bump frag-timeouts         2
    delta_pos bad-checksums        "$TCP_BAD_CSUM"    && hp_bump bad-checksums         2

    for name in "${HP_ORDER[@]}"; do
        if hp_active "$name"; then
            score=$(( score - ${HP_PEN[$name]:-0} ))
            reasons+="${HP_TXT[$name]:-$name}; "
        fi
    done
    if [ "$COUNTER_RESETS" -gt 0 ]; then
        reasons+="counter-resets=${COUNTER_RESETS}; "
    fi

    [ "$score" -lt 0 ] && score=0
    [ "$score" -gt 100 ] && score=100
    HEALTH_PCT="$score"
    HEALTH_REASONS="$reasons"
}

set_health_color() {
    if [ "$HEALTH_PCT" -ge 90 ]; then HC="$GREEN"
    elif [ "$HEALTH_PCT" -ge 60 ]; then HC="$YELLOW"
    else HC="$RED"; fi
}

# ------------------------------------------------------------------------------
# RATE ENGINE + LIVE TOTALS
#   * Socket rates are computed over the real time between stats snapshots.
#   * Once the snapshot goes stale, held rates DECAY (RATE_DECAY per cycle) so
#     they fall when traffic lowers instead of freezing.
#   * pps/Mbit fall back to live NIC counters between ticks.
#   * LIVE_PKTS / LIVE_BYTES interpolate the totals between snapshots so the
#     total packet counter updates EVERY refresh (default: every 2s).
# ------------------------------------------------------------------------------
peak_roll() {   # $1 = current, $2 = peak, $3 = floor -> NEW_PEAK
    local cur="$1" peak="$2" floor="$3"
    if [ "$cur" -ge "$peak" ]; then
        peak="$cur"
    else
        peak=$(( (peak * 3 + cur) / 4 ))
        [ "$peak" -lt "$floor" ] && peak="$floor"
        [ "$cur" -gt "$peak" ] && peak="$cur"
    fi
    NEW_PEAK="$peak"
}

# Live NIC totals from /proc/net/dev. Always up to date, regardless of how
# often Suricata refreshes its stats snapshot.
read_iface_stats() {
    awk -v inc="$NIC_IFACES" "$AWK_IFACE" /proc/net/dev 2>/dev/null || echo "0 0"
}

calculate_all_rates() {
    local changed=0 dt out np nm pr mb elapsed d

    [ -r /proc/net/dev ] && NIC_OK=1 || NIC_OK=0
    read -r NIC_PKTS NIC_BYTES <<< "$(read_iface_stats)"
    NIC_PKTS="$(safe_int "$NIC_PKTS")"; NIC_BYTES="$(safe_int "$NIC_BYTES")"

    # ---- socket snapshot: did Suricata publish new numbers? -----------------
    if [ "$SNAP_TS" -eq 0 ]; then
        SNAP_TS="$NOW_TS"
    elif [ "$EFF_PKTS" -lt "$SNAP_PKTS" ] || [ "${ALERTS:-0}" -lt "$SNAP_ALERTS" ] \
         || [ "$PKT_SRC" != "$SNAP_PKT_SRC" ]; then
        COUNTER_RESETS=$(( COUNTER_RESETS + 1 ))     # restart / source change
        SNAP_TS="$NOW_TS"
    elif [ "$EFF_PKTS" != "$SNAP_PKTS" ] || [ "$EFF_BYTES" != "$SNAP_BYTES" ] \
         || [ "$EFF_FLOWS" != "$SNAP_FLOWS" ] || [ "${ALERTS:-0}" != "$SNAP_ALERTS" ] \
         || [ "${KERNEL_DROPS:-0}" != "$SNAP_DROPS" ]; then
        changed=1
    fi

    if [ "$changed" -eq 1 ]; then
        dt=$(( NOW_TS - SNAP_TS )); [ "$dt" -lt 1 ] && dt=1
        out="$(awk -v ms="$dt" \
            -v cp="$EFF_PKTS"  -v pp="$SNAP_PKTS" \
            -v cb="$EFF_BYTES" -v pb="$SNAP_BYTES" \
            -v cf="$EFF_FLOWS" -v pf="$SNAP_FLOWS" \
            -v ca="${ALERTS:-0}"       -v pa="$SNAP_ALERTS" \
            -v cd="${KERNEL_DROPS:-0}" -v pd="$SNAP_DROPS" \
            -v carp="${ARP_PKTS:-0}"   -v parp="$SNAP_ARP" "$AWK_RATES" 2>/dev/null)"
        if [ -n "$out" ]; then
            read -r SOCK_PPS SOCK_MBIT SOCK_DROPS SOCK_ALERTS SOCK_FLOWS SOCK_ARPR <<< "$out"
        fi
        SOCK_UNTIL=$(( NOW_TS + 2 * dt + 1000 ))
        SNAP_TS="$NOW_TS"
    fi
    SNAP_PKTS="$EFF_PKTS"; SNAP_BYTES="$EFF_BYTES"; SNAP_FLOWS="$EFF_FLOWS"
    SNAP_ALERTS="${ALERTS:-0}"; SNAP_DROPS="${KERNEL_DROPS:-0}"; SNAP_PKT_SRC="$PKT_SRC"
    SNAP_ARP="${ARP_PKTS:-0}"

    # ---- decay stale held rates once per cycle ------------------------------
    # Between stats snapshots (or after Suricata stops reporting traffic) the
    # held socket rates decay smoothly toward 0 so displayed values LOWER when
    # traffic lowers, instead of freezing at the last snapshot rate.
    if [ "$NOW_TS" -gt "$SOCK_UNTIL" ] && [ "$LAST_DECAY_CYCLE" != "$CYCLE" ]; then
        out="$(awk -v f="$RATE_DECAY" -v a="$SOCK_PPS" -v b="$SOCK_MBIT" \
                    -v c="$SOCK_DROPS" -v d="$SOCK_ALERTS" -v e="$SOCK_FLOWS" -v g="$SOCK_ARPR" \
               "$AWK_DECAY")"
        read -r SOCK_PPS SOCK_MBIT SOCK_DROPS SOCK_ALERTS SOCK_FLOWS SOCK_ARPR <<< "$out"
        LAST_DECAY_CYCLE="$CYCLE"
    fi

    # ---- alerts / drops / flows / arp rates: fresh, held, or decaying --------
    ALERT_RATE="$SOCK_ALERTS"; DROP_RATE="$SOCK_DROPS"; FLOW_RATE="$SOCK_FLOWS"
    ARP_RATE="$SOCK_ARPR"

    # ---- pps / Mbit/s: fresh socket data, else live NIC counters -----------
    RATE_SRC="socket"
    PKT_RATE="0.00"; MBIT_RATE="0.00"
    if [ "$changed" -eq 1 ] && awk -v a="$SOCK_PPS" -v b="$SOCK_MBIT" 'BEGIN { exit !(a+0 > 0 || b+0 > 0) }'; then
        PKT_RATE="$SOCK_PPS"; MBIT_RATE="$SOCK_MBIT"
    elif [ "$NIC_SEEN" -eq 1 ] && [ "$NIC_OK" -eq 1 ]; then
        elapsed=$(( NOW_TS - PREV_TS )); [ "$elapsed" -lt 50 ] && elapsed=1000
        out="$(awk -v ms="$elapsed" -v cp="$NIC_PKTS" -v pp="$NIC_PREV_PKTS" \
                   -v cb="$NIC_BYTES" -v pb="$NIC_PREV_BYTES" "$AWK_NIC")"
        read -r np nm <<< "$out"
        PKT_RATE="${np:-0.00}"; MBIT_RATE="${nm:-0.00}"
        RATE_SRC="nic (/proc/net/dev)"
    else
        PKT_RATE="$SOCK_PPS"; MBIT_RATE="$SOCK_MBIT"
        RATE_SRC="socket (decaying)"
    fi

    # ---- LIVE TOTALS: update every cycle (exact at snapshots, interpolated
    #      between them from the NIC counters anchored at the last snapshot) --
    if [ "$changed" -eq 1 ]; then
        LAST_SNAP_EFF="$EFF_PKTS"; LAST_SNAP_EFF_B="$EFF_BYTES"
        NIC_SNAP_PKTS="$NIC_PKTS"; NIC_SNAP_BYTES="$NIC_BYTES"
        LIVE_OK=1
    fi
    if [ "$LIVE_OK" -eq 1 ]; then
        d=$(( NIC_PKTS - NIC_SNAP_PKTS ));  [ "$d" -lt 0 ] && d=0
        LIVE_PKTS=$(( LAST_SNAP_EFF + d ))
        d=$(( NIC_BYTES - NIC_SNAP_BYTES )); [ "$d" -lt 0 ] && d=0
        LIVE_BYTES=$(( LAST_SNAP_EFF_B + d ))
    else
        LIVE_PKTS="$LAST_SNAP_EFF"; LIVE_BYTES="$LAST_SNAP_EFF_B"
    fi
    if [ "$LIVE_INIT" = "1" ]; then
        LIVE_DELTA_PKTS=$(( LIVE_PKTS - LIVE_PREV_PKTS ))
        [ "$LIVE_DELTA_PKTS" -lt 0 ] && LIVE_DELTA_PKTS=0
        LIVE_DELTA_BYTES=$(( LIVE_BYTES - LIVE_PREV_BYTES ))
        [ "$LIVE_DELTA_BYTES" -lt 0 ] && LIVE_DELTA_BYTES=0
    else
        LIVE_DELTA_PKTS=0; LIVE_DELTA_BYTES=0; LIVE_INIT=1
    fi
    LIVE_PREV_PKTS="$LIVE_PKTS"; LIVE_PREV_BYTES="$LIVE_BYTES"

    NIC_PREV_PKTS="$NIC_PKTS"; NIC_PREV_BYTES="$NIC_BYTES"; NIC_SEEN=1

    if [ "${DEBUG_RATES:-0}" = "1" ]; then
        printf 'DEBUG cycle=%s changed=%s pkts=%s bytes=%s live=%s (+%s) nic=%s/%s => pps=%s mbit=%s arp=%s src=%s\n' \
            "$CYCLE" "$changed" "$EFF_PKTS" "$EFF_BYTES" "$LIVE_PKTS" "$LIVE_DELTA_PKTS" \
            "$NIC_PKTS" "$NIC_BYTES" "$PKT_RATE" "$MBIT_RATE" "$ARP_RATE" "$RATE_SRC" >&2
    fi

    # Rolling peaks (hundredths) drive the auto-scaling bars.
    pr=$(( 10#${PKT_RATE/./} ))
    peak_roll "$pr" "$PEAK" 1;    PEAK="$NEW_PEAK"
    mb=$(( 10#${MBIT_RATE/./} ))
    peak_roll "$mb" "$PEAK_MB" 1; PEAK_MB="$NEW_PEAK"

    PREV_TS="$NOW_TS"
}

make_graph() {
    local val=$1 peak=$2 bars
    [ "$peak" -lt 1 ] && peak=1
    [ "$val" -lt 0 ] && val=0
    bars=$(( (val * GRAPH_MAX + peak / 2) / peak ))
    [ "$bars" -gt "$GRAPH_MAX" ] && bars=$GRAPH_MAX
    [ "$val" -gt 0 ] && [ "$bars" -lt 1 ] && bars=1
    printf '%s' "${BLOCK40:0:bars}${EMPTY40:0:GRAPH_MAX-bars}"
}

hund() { printf '%d.%02d' $(( $1 / 100 )) $(( $1 % 100 )); }

# Lifetime kernel drop ratio (informational). n/a if the capture method has no
# capture.* counters (e.g. NFQ).
kernel_drop_percent() {
    if [ "${DV[KERNEL_PKTS]}" = "n/a" ]; then printf 'n/a'; return; fi
    awk -v packets="${KERNEL_PKTS:-0}" -v drops="${KERNEL_DROPS:-0}" "$AWK_KDROP"
}

alert_ratio() {
    awk -v packets="${EFF_PKTS:-0}" -v alerts="${ALERTS:-0}" "$AWK_ARATIO"
}

# ==============================================================================
# HARDWARE / VENDOR HEALTH  (IBM, Lenovo, Dell, HP/HPE, Fujitsu, Supermicro,
#   Huawei, ASUS, Acer, MSI, Gigabyte, Apple, Oracle/Sun, Toshiba, Samsung,
#   and virtual platforms: QEMU/KVM, VMware, Hyper-V, Xen, VirtualBox)
#   The vendor is auto-detected from DMI; each vendor toolchain is probed and
#   only used when installed, with generic Linux interfaces (/sys, lm-sensors,
#   smartmontools, edac, ipmitool) as the universal fallback. Read-only: no
#   vendor tool is ever invoked in a modifying mode.
# ==============================================================================
HW_VENDOR="Unknown"; HW_VENDOR_RAW=""; HW_MODEL="n/a"; HW_TYPE="Unknown"
HW_CPU_TEMP="n/a"; HW_CPU_TEMP_SRC="none"; HW_FAN="n/a"; HW_FAN_SRC="none"
HW_BAT_STATUS="n/a"; HW_BAT_PCT="n/a"; HW_BAT_WEAR="n/a"
HW_SMART_TOTAL=0; HW_SMART_BAD=0; HW_SMART_SCANNED=0
HW_RAID_STATUS="n/a"; HW_RAID_SRC="none"
HW_MEM_CE=0; HW_MEM_UE=0; HW_MEM_SRC="/sys edac"
HW_SEL_LAST="none"
HW_CPU_FREQ="n/a"; HW_CPU_FREQ_MAX="n/a"; HW_THROTTLED=0
HW_PCT=100; HW_STATUS="OK"; HW_HWC=""; HW_TOOLS="not probed"; HW_NOTE=""

hw_canonical_vendor() {
    local v="${1,,}" u
    u="${v// /_}"          # spaces removed: every glob pattern stays space-free
    case "$u" in
        *ibm*)                                                     HW_VENDOR="IBM" ;;
        *lenovo*|*thinkpad*|*thinkcentre*|*thinkstation*|*thinksystem*|*thinkedge*|*legion*|*ideapad*) HW_VENDOR="Lenovo" ;;
        *hewlett*|*hp*|*proliant*|*aruba*)                        HW_VENDOR="HP / HPE" ;;
        *dell*|*poweredge*)                                        HW_VENDOR="Dell" ;;
        *fujitsu*|*primergy*|*siemens*)                            HW_VENDOR="Fujitsu" ;;
        *supermicro*|*smtc*)                                       HW_VENDOR="Supermicro" ;;
        *huawei*|*h3c*)                                            HW_VENDOR="Huawei" ;;
        *gigabyte*)                                                HW_VENDOR="Gigabyte" ;;
        *asus*|*asustek*)                                          HW_VENDOR="ASUS" ;;
        *acer*|*packard*)                                          HW_VENDOR="Acer" ;;
        *msi*|*micro-star*|*micro_star*)                           HW_VENDOR="MSI" ;;
        *apple*|*macbook*)                                         HW_VENDOR="Apple" ;;
        *oracle*|*sun*)                                            HW_VENDOR="Oracle/Sun" ;;
        *toshiba*)                                                 HW_VENDOR="Toshiba" ;;
        *samsung*)                                                 HW_VENDOR="Samsung" ;;
        *qemu*|*kvm*|*bochs*)                                      HW_VENDOR="QEMU/KVM (VM)" ;;
        *vmware*)                                                  HW_VENDOR="VMware (VM)" ;;
        *microsoft*)                                               HW_VENDOR="Hyper-V (VM)" ;;
        *xen*)                                                     HW_VENDOR="Xen (VM)" ;;
        *innotek*|*virtualbox*)                                    HW_VENDOR="VirtualBox (VM)" ;;
        *to_be_filled*|" "|"")                                    HW_VENDOR="Unknown (OEM)" ;;
        *o.e.m*|*o.e.m.*|*system_manufacturer*|*default_string*)   HW_VENDOR="Unknown (OEM)" ;;
        *) HW_VENDOR="$(printf '%s' "$1" | head -c 16)" ;;
    esac
}

hw_detect_platform() {
    local v="" m="" ct="" t
    v="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
    m="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
    ct="$(cat /sys/class/dmi/id/chassis_type 2>/dev/null || true)"
    HW_VENDOR_RAW="$v"
    hw_canonical_vendor "$v"
    HW_MODEL="$(printf '%s' "$m" | tr -d '\n' | head -c 22)"
    if printf '%s' "$HW_VENDOR" | grep -q '(VM)'; then
        HW_TYPE="Virtual"
        HW_NOTE="virtual platform: thermal/SMART/RAID data depends on host passthrough"
    else
        case "$ct" in
            8|9|10|14)                    HW_TYPE="Laptop" ;;
            30|31|32)                     HW_TYPE="Tablet/Conv." ;;
            17|22|23)                     HW_TYPE="Server/Rack" ;;
            3|4|5|6|7|15|16|24|35|36)     HW_TYPE="Desktop/Tower" ;;
            *)                             HW_TYPE="Barebone/Other" ;;
        esac
    fi
    hw_probe_tools
}

# Which vendor / OEM toolchain is available on this box (informational + used
# by the probes below). Every check is presence-based, nothing is guessed.
hw_probe_tools() {
    local t=""
    case "$HW_VENDOR" in
        IBM)
            command -v iprconfig   >/dev/null 2>&1 && t="iprconfig"
            ;;
        Lenovo)
            [ -r /proc/acpi/ibm/thermal ] && t="thinkpad-acpi"
            command -v storcli64  >/dev/null 2>&1 && t="$t storcli"
            command -v OneCLI     >/dev/null 2>&1 && t="$t OneCLI"
            ;;
        HP*)
            command -v hpasmcli   >/dev/null 2>&1 && t="hpasmcli"
            command -v ssacli    >/dev/null 2>&1 && t="$t ssacli"
            command -v hpssacli  >/dev/null 2>&1 && t="$t hpssacli"
            ;;
        Dell)
            command -v omreport  >/dev/null 2>&1 && t="omreport"
            command -v racadm    >/dev/null 2>&1 && t="$t racadm"
            ;;
        Supermicro)
            command -v ipmitool  >/dev/null 2>&1 && t="ipmitool smc"
            ;;
        *)
            command -v ipmitool  >/dev/null 2>&1 && t="ipmitool"
            ;;
    esac
    # generic layer every vendor can use
    command -v sensors   >/dev/null 2>&1 && t="$t sensors"
    command -v smartctl   >/dev/null 2>&1 && t="$t smartctl"
    command -v storcli    >/dev/null 2>&1 && t="$t storcli"
    command -v MegaCli    >/dev/null 2>&1 && t="$t MegaCli"
    command -v arcconf    >/dev/null 2>&1 && t="$t arcconf"
    command -v nvme      >/dev/null 2>&1 && t="$t nvme"
    HW_TOOLS="${t:-kernel /sys only}"
}

hw_read_cpu_temp() {
    local zone ztype t best="" src="" out
    # 1. kernel thermal zones (prefer CPU/package sensors)
    for zone in /sys/class/thermal/thermal_zone*; do
        [ -r "$zone/temp" ] || continue
        t=$(( $(cat "$zone/temp" 2>/dev/null || echo 0) / 1000 ))
        [ "$t" -gt 0 ] && [ "$t" -lt 120 ] || continue
        ztype="$(cat "$zone/type" 2>/dev/null || true)"
        case "$ztype" in
            *cpu*|*package*|*pkg*|*soc*|*core*|*die*)
                if [ -z "$best" ] || [ "$t" -gt "$best" ]; then best="$t"; src="tz:$ztype"; fi ;;
        esac
    done
    # any thermal zone when no CPU-specific one exists
    if [ -z "$best" ]; then
        for zone in /sys/class/thermal/thermal_zone*; do
            [ -r "$zone/temp" ] || continue
            t=$(( $(cat "$zone/temp" 2>/dev/null || echo 0) / 1000 ))
            if [ "$t" -gt 0 ] && [ "$t" -lt 120 ]; then
                if [ -z "$best" ] || [ "$t" -gt "$best" ]; then best="$t"; src="tz:max"; fi
            fi
        done
    fi
    if [ -n "$best" ]; then HW_CPU_TEMP="$best"; HW_CPU_TEMP_SRC="$src"; fi
    # 2. lm-sensors (precise core temps on most vendors)
    if command -v sensors >/dev/null 2>&1; then
        out="$(sensors -u 2>/dev/null | awk '/^  temp[0-9]+:/{l=$1; sub(/:$/,"",l)} /^  temp[0-9]+_input:/{v=$2+0; if(v>0&&v<130&&v>b){b=v;s=l}} END{if(b>0) printf "%.0f %s", b, s}')"
        if [ -n "$out" ]; then
            read -r t src <<< "$out"
            [ -n "${t:-}" ] && { HW_CPU_TEMP="$t"; HW_CPU_TEMP_SRC="sensors:$src"; }
        fi
    fi
    # 3. IBM / Lenovo ThinkPad ACPI
    if [ -r /proc/acpi/ibm/thermal ]; then
        t="$(awk '{print $2+0; exit}' /proc/acpi/ibm/thermal 2>/dev/null)"
        if [ -n "$t" ] && [ "$t" -gt 0 ] && [ "$t" -lt 120 ]; then
            HW_CPU_TEMP="$t"; HW_CPU_TEMP_SRC="thinkpad-acpi"
        fi
    fi
    # 4. BMC / IPMI SDR (servers: IBM, Lenovo ThinkSystem, Dell iDRAC, HPE, Supermicro)
    if [ "$IPMI_ENABLED" = "1" ] && command -v ipmitool >/dev/null 2>&1; then
        t="$(ipmitool sdr type temperature 2>/dev/null | awk '/degrees C/{for(i=NF-2;i>=1;i--){if($i ~ /^-?[0-9]+(\.[0-9]+)?$/){v=$i+0; if(v>0&&v<130&&v>b)b=v; break}}} END{if(b>0) printf "%.0f", b}')"
        if [ -n "$t" ]; then HW_CPU_TEMP="$t"; HW_CPU_TEMP_SRC="ipmi-sdr"; fi
    fi
}

hw_read_fan() {
    local out rpm src t
    HW_FAN="n/a"; HW_FAN_SRC="none"
    if command -v sensors >/dev/null 2>&1; then
        out="$(sensors -u 2>/dev/null | awk '/^  fan[0-9]+:/{l=$1; sub(/:$/,"",l)} /^  fan[0-9]+_input:/{v=$2+0; if(v>0&&v<50000&&v>b){b=v;s=l}} END{if(b>0) printf "%.0f %s", b, s}')"
        if [ -n "$out" ]; then
            read -r rpm src <<< "$out"
            [ -n "${rpm:-}" ] && { HW_FAN="$rpm rpm"; HW_FAN_SRC="sensors:$src"; }
        fi
    fi
    if [ -r /proc/acpi/ibm/fan ]; then
        t="$(sed -n 's/^speed:[[:space:]]*\([0-9]\{1,\}\).*/\1/p' /proc/acpi/ibm/fan 2>/dev/null)"
        [ -n "$t" ] && { HW_FAN="$t rpm"; HW_FAN_SRC="thinkpad-acpi"; }
    fi
    if [ "$IPMI_ENABLED" = "1" ] && command -v ipmitool >/dev/null 2>&1; then
        t="$(ipmitool sdr type fan 2>/dev/null | awk '/RPM/{for(i=NF-2;i>=1;i--){if($i ~ /^[0-9]+$/){v=$i+0; if(v>0&&v<50000&&v>b)b=v; break}}} END{if(b>0) printf "%.0f", b}')"
        [ -n "$t" ] && { HW_FAN="$t rpm"; HW_FAN_SRC="ipmi-sdr"; }
    fi
}

hw_read_battery() {
    local bat ty full design
    HW_BAT_STATUS="n/a"; HW_BAT_PCT="n/a"; HW_BAT_WEAR="n/a"
    for bat in /sys/class/power_supply/*; do
        [ -d "$bat" ] || continue
        ty="$(cat "$bat/type" 2>/dev/null || true)"
        [ "$ty" = "Battery" ] || continue
        HW_BAT_STATUS="$(cat "$bat/status" 2>/dev/null || echo n/a)"
        HW_BAT_PCT="$(cat "$bat/capacity" 2>/dev/null || echo n/a)"
        full="$(cat "$bat/energy_full" 2>/dev/null || cat "$bat/charge_full" 2>/dev/null || echo 0)"
        design="$(cat "$bat/energy_full_design" 2>/dev/null || cat "$bat/charge_full_design" 2>/dev/null || echo 0)"
        if [[ "$design" =~ ^[0-9]+$ ]] && [ "$design" -gt 0 ] && [[ "$full" =~ ^[0-9]+$ ]] && [ "$full" -gt 0 ]; then
            HW_BAT_WEAR=$(( (design - full) * 100 / design ))
            [ "$HW_BAT_WEAR" -lt 0 ] && HW_BAT_WEAR=0
        fi
        break
    done
}

hw_read_cpu_freq() {
    local cur max sc
    cur="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null || true)"
    max="$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null || true)"
    sc="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || true)"
    if [[ "$cur" =~ ^[0-9]+$ ]]; then HW_CPU_FREQ=$(( cur / 1000 )); else HW_CPU_FREQ="n/a"; fi
    if [[ "$max" =~ ^[0-9]+$ ]]; then HW_CPU_FREQ_MAX=$(( max / 1000 )); else HW_CPU_FREQ_MAX="n/a"; fi
    HW_THROTTLED=0
    if [[ "$sc" =~ ^[0-9]+$ ]] && [[ "$max" =~ ^[0-9]+$ ]] && [ "$max" -gt 0 ]; then
        [ "$sc" -lt $(( max * 90 / 100 )) ] && HW_THROTTLED=1
    fi
}

hw_read_mem_errors() {
    local mc n
    HW_MEM_CE=0; HW_MEM_UE=0; HW_MEM_SRC="/sys edac"
    for mc in /sys/devices/system/edac/mc/mc*; do
        [ -d "$mc" ] || continue
        n="$(safe_int "$(cat "$mc/ce_count" 2>/dev/null)")"
        HW_MEM_CE=$(( HW_MEM_CE + n ))
        n="$(safe_int "$(cat "$mc/ue_count" 2>/dev/null)")"
        HW_MEM_UE=$(( HW_MEM_UE + n ))
    done
    [ -d /sys/devices/system/edac/mc ] || HW_MEM_SRC="n/a (no edac)"
}

hw_scan_smart() {
    local d out
    HW_SMART_SCANNED=0; HW_SMART_TOTAL=0; HW_SMART_BAD=0
    [ "$SMART_ENABLED" = "1" ] || return 0
    command -v smartctl >/dev/null 2>&1 || return 0
    for d in /dev/sd[a-z] /dev/sd[a-z][a-z] /dev/sd[a-z][a-z][a-z] \
             /dev/nvme[0-9]n[0-9] /dev/nvme[0-9][0-9]n[0-9]; do
        [ -b "$d" ] || continue
        HW_SMART_TOTAL=$(( HW_SMART_TOTAL + 1 ))
        out="$(smartctl -H -n standby "$d" 2>/dev/null || true)"
        if printf '%s\n' "$out" | grep -qi 'FAILED'; then
            HW_SMART_BAD=$(( HW_SMART_BAD + 1 ))
        fi
    done
    HW_SMART_SCANNED=1
}

hw_raid_from_text() {
    local txt="$1"
    if printf '%s\n' "$txt" | grep -qi 'degraded\|failed\|offline'; then
        HW_RAID_STATUS="DEGRADED"
    elif printf '%s\n' "$txt" | grep -qi 'optimal\|healthy'; then
        HW_RAID_STATUS="OK"
    elif printf '%s\n' "$txt" | grep -qwi 'ok'; then
        HW_RAID_STATUS="OK"
    else
        HW_RAID_STATUS="unknown"
    fi
}

# RAID status via every major OEM/LSI toolchain, in order. LSI/Broadcom
# controllers are the base for Lenovo ThinkSystem, IBM, Dell (PERC),
# Supermicro and Fujitsu, so storcli/MegaCli cover a very wide vendor range.
hw_probe_raid() {
    local out
    HW_RAID_STATUS="n/a"; HW_RAID_SRC="none"
    if command -v storcli >/dev/null 2>&1; then
        out="$(storcli /call show 2>/dev/null || true)"
        [ -n "$out" ] && { HW_RAID_SRC="storcli"; hw_raid_from_text "$out"; }
    elif command -v storcli64 >/dev/null 2>&1; then
        out="$(storcli64 /call show 2>/dev/null || true)"
        [ -n "$out" ] && { HW_RAID_SRC="storcli64"; hw_raid_from_text "$out"; }
    fi
    if [ "$HW_RAID_STATUS" = "n/a" ] && command -v MegaCli >/dev/null 2>&1; then
        out="$(MegaCli -AdpAllInfo -aALL 2>/dev/null || true)"
        [ -n "$out" ] && { HW_RAID_SRC="MegaCli"; hw_raid_from_text "$out"; }
    fi
    if [ "$HW_RAID_STATUS" = "n/a" ] && command -v arcconf >/dev/null 2>&1; then
        out="$(arcconf getconfig 1 2>/dev/null || true)"
        [ -n "$out" ] && { HW_RAID_SRC="arcconf"; hw_raid_from_text "$out"; }
    fi
    if [ "$HW_RAID_STATUS" = "n/a" ] && command -v iprconfig >/dev/null 2>&1; then
        HW_RAID_STATUS="present"; HW_RAID_SRC="IBM ipr (iprconfig)"
    fi
    if [ "$HW_RAID_STATUS" = "n/a" ] && command -v omreport >/dev/null 2>&1; then
        out="$(omreport storage vdisk 2>/dev/null || true)"
        [ -n "$out" ] && { HW_RAID_SRC="omreport (Dell)"; hw_raid_from_text "$out"; }
    fi
    if [ "$HW_RAID_STATUS" = "n/a" ] && command -v ssacli >/dev/null 2>&1; then
        out="$(ssacli ctrl all show status 2>/dev/null || true)"
        [ -n "$out" ] && { HW_RAID_SRC="ssacli (HPE)"; hw_raid_from_text "$out"; }
    fi
    if [ "$HW_RAID_STATUS" = "n/a" ] && command -v hpssacli >/dev/null 2>&1; then
        out="$(hpssacli ctrl all show status 2>/dev/null || true)"
        [ -n "$out" ] && { HW_RAID_SRC="hpssacli (HPE)"; hw_raid_from_text "$out"; }
    fi
}

hw_read_sel() {
    local n line
    HW_SEL_LAST="none"
    [ "$IPMI_ENABLED" = "1" ] || return 0
    command -v ipmitool >/dev/null 2>&1 || return 0
    n="$(ipmitool sel list 2>/dev/null | wc -l)"
    n="$(printf '%s' "$n" | tr -d ' ')"
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    line="$(ipmitool sel list 2>/dev/null | tail -n 1 | cut -c1-30 | tr -d '\n')"
    [ -n "$line" ] && HW_SEL_LAST="$line (sel:$n)"
    if printf '%s' "$HW_SEL_LAST" | grep -qi 'critical'; then
        HW_SEL_LAST="CRIT: $HW_SEL_LAST"
    fi
}

hw_score() {
    local s=100 st="OK"
    if [[ "$HW_CPU_TEMP" =~ ^[0-9]+$ ]]; then
        if [ "$HW_CPU_TEMP" -ge "$HW_TEMP_CRIT" ]; then
            s=$(( s - 30 )); st="CRIT"
        elif [ "$HW_CPU_TEMP" -ge "$HW_TEMP_WARN" ]; then
            s=$(( s - 10 )); [ "$st" = "OK" ] && st="WARN"
        fi
    fi
    if [ "$HW_SMART_BAD" -gt 0 ]; then s=$(( s - 30 )); st="CRIT"; fi
    case "$HW_RAID_STATUS" in
        DEGRADED*) s=$(( s - 25 )); st="CRIT" ;;
    esac
    if [ "$HW_MEM_UE" -gt 0 ]; then s=$(( s - 15 )); [ "$st" = "OK" ] && st="WARN"; fi
    if [ "$HW_MEM_CE" -gt 0 ]; then s=$(( s - 5 )); [ "$st" = "OK" ] && st="WARN"; fi
    if [ "$HW_THROTTLED" = "1" ]; then s=$(( s - 5 )); [ "$st" = "OK" ] && st="WARN"; fi
    if [[ "$HW_BAT_WEAR" =~ ^[0-9]+$ ]] && [ "$HW_BAT_WEAR" -ge 40 ]; then
        s=$(( s - 5 )); [ "$st" = "OK" ] && st="WARN"
    fi
    if printf '%s' "$HW_SEL_LAST" | grep -qi '^CRIT'; then
        s=$(( s - 10 )); [ "$st" = "OK" ] && st="WARN"
    fi
    [ "$s" -lt 0 ] && s=0
    [ "$s" -gt 100 ] && s=100
    HW_PCT="$s"; HW_STATUS="$st"
    if [ "$st" = "CRIT" ]; then HW_HWC="$RED"
    elif [ "$st" = "WARN" ]; then HW_HWC="$YELLOW"
    else HW_HWC="$GREEN"; fi
}

# Cheap probes (pure /sys + one sensors pass) run every refresh cycle.
hw_collect_quick() {
    hw_read_cpu_temp
    hw_read_fan
    hw_read_battery
    hw_read_cpu_freq
    hw_read_mem_errors
    hw_score
}

# Heavy probes (SMART / RAID / IPMI SEL) run on the slow refresh cadence.
hw_collect_deep() {
    hw_scan_smart
    hw_probe_raid
    hw_read_sel
    hw_score
}

