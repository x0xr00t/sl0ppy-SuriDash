sc_json() {
    local command="${1:-}" raw
    [ -n "$command" ] || return 1
    raw="$(sc_raw "$command")" || return 1
    [ -n "$raw" ] || return 1
    if printf '%s\n' "$raw" | jq -e . >/dev/null 2>&1; then
        printf '%s\n' "$raw"
        return 0
    fi
    # Older suricatasc builds print a python-style dict: convert it.
    # (data goes through the environment: stdin carries the python script)
    if command -v python3 >/dev/null 2>&1; then
        RAW_JSON="$raw" python3 - 2>/dev/null <<'PYEOF' && return 0
import os, sys, json, ast
data = os.environ.get("RAW_JSON", "").strip()
try:
    obj = json.loads(data)
except Exception:
    try:
        obj = ast.literal_eval(data)
    except Exception:
        sys.exit(1)
print(json.dumps(obj, separators=(",", ":")))
PYEOF
    fi
    return 1
}

