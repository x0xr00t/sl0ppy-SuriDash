    row "HTTP:" "${DV[A_HTTP]}" "$CYAN" "TLS:" "${DV[A_TLS]}" "$CYAN" "DNS/TCP:" "${DV[A_DNS_TCP]}" "$CYAN"
    row "DNS/UDP:" "${DV[A_DNS_UDP]}" "$CYAN" "QUIC:" "${DV[A_QUIC]}" "$CYAN" "SSH:" "${DV[A_SSH]}" "$CYAN"
    row "FTP:" "${DV[A_FTP]}" "$CYAN" "SMB:" "${DV[A_SMB]}" "$CYAN" "DHCP:" "${DV[A_DHCP]}" "$CYAN"
    row "NTP:" "${DV[A_NTP]}" "$CYAN" "DCERPC/T:" "${DV[A_DCERPC_TCP]}" "$CYAN" "DCERPC/U:" "${DV[A_DCERPC_UDP]}" "$CYAN"

    section "OTHER PROTOCOLS"
    show_other_protos

    section "DETECTION & INSPECTION"
    row "Total alerts:" "${DV[ALERTS]}" "$RED${BOLD}" "Rules loaded:" "$rules_txt" "$YELLOW" "Suppressed:" "${DV[DETECT_SUPPR]}" "$CYAN"
    row "Queue ovfl:" "${DV[DETECT_QUEUE]}" "$YELLOW" "Frag reasm:" "${DV[FRAG_REASM]}" "$CYAN" "Frag timeouts:" "${DV[FRAG_TIMEOUTS]}" "$YELLOW"
    row "Frag packets:" "${DV[FRAG_FRAGS]}" "$CYAN" "Frag memcap:" "${DV[FRAG_MEMCAP]}" "$CYAN" "Frag max-hits:" "${DV[FRAG_MAXHITS]}" "$CYAN"
    row "App errors:" "${DV[AL_ERR]}" "$YELLOW" "App gaps:" "${DV[AL_GAP]}" "$CYAN" "App failed:" "${DV[AL_FAILED]}" "$CYAN"
    row "Bad checksums:" "${DV[TCP_BAD_CSUM]}" "$YELLOW" "Frag mem use:" "${DV[FRAG_MEM_USE]}" "$CYAN" "Inspect:" "$inspect" "$GREEN"

    printf '\n'
    show_alert_boxes

    printf '\n'
    show_eve_stats

    show_health

    printf '\n'
    printf '%s\n' "${BLUE}${BOLD}${rule}${NC}"
    printf '%s\n' "${WHITE}  Refresh every ${CYAN}${REFRESH_INTERVAL}s${NC} | ${WHITE}Stop: ${RED}q / Ctrl+C${NC} | ${WHITE}Log: ${CYAN}${FAST_LOG}${NC}"
    printf '%s\n' "${DIM}  Suridash ${Suridash_Version} - read-only mode: nothing in the Suricata configuration is modified.${NC}"
    printf '%s\n' "${BLUE}${BOLD}${rule}${NC}"
}

# ------------------------------------------------------------------------------
# CYCLE: collect everything and build the next frame
# ------------------------------------------------------------------------------
set_frame() {
    local t
    FRAME="$1"
    t="${FRAME//[^$'\n']/}"
    FRAME_LINES=$(( ${#t} + 1 ))
}

collect_cycle() {
    CYCLE=$(( CYCLE + 1 ))
    get_now_ms

    if [ "$SOCKET_STATUS" != "OK" ]; then
        discover_socket && get_suricata_version
    fi
    if [ "$SOCKET_STATUS" = "OK" ]; then
        JSON_DATA="$(sc_json dump-counters 2>/dev/null || true)"
        get_now_ms
        [ -n "$JSON_DATA" ] || SOCKET_STATUS="FAILED"
    fi
    if [ "$SOCKET_STATUS" != "OK" ]; then
        update_term_width
        set_frame "$(show_connection_error)"
        return 1
    fi

    parse_counters "$JSON_DATA"
    compute_effective
    calculate_all_rates
    update_term_width
    compute_health

    if [ "$(safe_int "${PKT_RATE%.*}")" -gt "$HIGH_LOAD_PPS" ]; then
        LOAD_LABEL="HIGH LOAD"
        ACTIVE_EVE_LINES="$EVE_SAMPLE_LINES_HIGH"
    else
        LOAD_LABEL="NORMAL"
        ACTIVE_EVE_LINES="$EVE_SAMPLE_LINES"
    fi

    if [ "$FORCE_REFRESH" = "1" ] \
       || [ $(( NOW_TS - LAST_EVE_TS )) -ge $(( EVE_REFRESH_EVERY * REFRESH_INTERVAL * 1000 )) ]; then
        collect_eve_stats "$ACTIVE_EVE_LINES"
        EVE_DISPLAY_SAMPLE="$ACTIVE_EVE_LINES"
        collect_recent_alerts
        LAST_EVE_TS="$NOW_TS"
    fi
    if [ "$FORCE_REFRESH" = "1" ] \
       || [ $(( NOW_TS - LAST_SLOW_TS )) -ge $(( SLOW_REFRESH_EVERY * REFRESH_INTERVAL * 1000 )) ]; then
        get_rules_loaded
        [ "${UPTIME_C:-0}" -gt 0 ] || sync_uptime
        LAST_SLOW_TS="$NOW_TS"
    fi
    FORCE_REFRESH=0
    resolve_uptime
    get_other_protos

    set_frame "$(render_frame)"
    return 0
}

# ------------------------------------------------------------------------------
# INTERACTIVE DISPLAY
# ------------------------------------------------------------------------------
draw() {
    local rows body maxoff status
    rows="$(tput lines 2>/dev/null || echo 40)"
    [[ "$rows" =~ ^[0-9]+$ ]] || rows=40
    body=$(( rows - 1 )); [ "$body" -lt 5 ] && body=5
    maxoff=$(( FRAME_LINES - body )); [ "$maxoff" -lt 0 ] && maxoff=0
    [ "$OFFSET" -gt "$maxoff" ] && OFFSET="$maxoff"
    [ "$OFFSET" -lt 0 ] && OFFSET=0

    status=" q quit | p pause | r refresh | j/k PgUp/PgDn g/G scroll | lines $((OFFSET+1))-$(( OFFSET+body > FRAME_LINES ? FRAME_LINES : OFFSET+body ))/${FRAME_LINES}"
    [ "$PAUSED" = "1" ] && status+=" | PAUSED"

    printf '\033[H'
    printf '%s\n' "$FRAME" | awk -v a=$((OFFSET+1)) -v b=$((OFFSET+body)) \
        'NR >= a && NR <= b { printf "%s\033[K\n", $0 }'
    printf '\033[J\033[%d;1H%s%s%s\033[K' "$rows" "$REV" "$status" "$NC"
}

# Wait up to REFRESH_INTERVAL for the next cycle while serving key presses.
wait_for_input() {
    local deadline remain t key rest rows body
    get_now_ms
    deadline=$(( NOW_TS + REFRESH_INTERVAL * 1000 ))
    while true; do
        get_now_ms
        remain=$(( deadline - NOW_TS ))
        if [ "$PAUSED" = "0" ] && [ "$remain" -le 0 ]; then return; fi
        [ "$remain" -lt 50 ] && remain=200
        if [ -t 0 ]; then
            printf -v t '%d.%03d' $(( remain / 1000 )) $(( remain % 1000 ))
            key=""
            if read -rsn1 -t "$t" key; then
                if [ "$key" = $'\e' ]; then
                    read -rsn2 -t 0.02 rest || rest=""
                    case "$rest" in
                        "[A") key="k" ;;
                        "[B") key="j" ;;
                        "[5") key="PGUP" ;;
                        "[6") key="PGDN" ;;
                        "[H") key="g" ;;
                        "[F") key="G" ;;
                        *)    key="" ;;
                    esac
                fi
                rows="$(tput lines 2>/dev/null || echo 40)"; body=$(( rows - 2 ))
                case "$key" in
                    q|Q) exit 0 ;;
                    p|P) if [ "$PAUSED" = "1" ]; then PAUSED=0; return; else PAUSED=1; draw; fi ;;
                    r|R) FORCE_REFRESH=1; PAUSED=0; return ;;
                    j)   OFFSET=$(( OFFSET + 1 )); draw ;;
                    k)   OFFSET=$(( OFFSET - 1 )); draw ;;
                    PGDN|" ") OFFSET=$(( OFFSET + body )); draw ;;
                    PGUP|b)   OFFSET=$(( OFFSET - body )); draw ;;
                    g)   OFFSET=0; draw ;;
                    G)   OFFSET=999999; draw ;;
                esac
            fi
        else
            sleep "$(( remain / 1000 + 1 ))"
            [ "$PAUSED" = "1" ] || return
        fi
    done
}

# ------------------------------------------------------------------------------
# STARTUP
# ------------------------------------------------------------------------------
discover_socket
[ "$SOCKET_STATUS" = "OK" ] && get_suricata_version
get_now_ms
update_term_width

# ---- diagnostic modes ----------------------------------------------------------
if [ "$DEBUG_COUNTERS" = "1" ] || [ "$CHECK_MODE" = "1" ]; then
    if [ "$SOCKET_STATUS" != "OK" ]; then
        show_connection_error
        exit 1
    fi
    JSON_DATA="$(sc_json dump-counters 2>/dev/null || true)"
    if [ -z "$JSON_DATA" ]; then
        printf '%s\n' "${RED}[-] dump-counters returned nothing.${NC}"
        exit 1
    fi
    if [ "$DEBUG_COUNTERS" = "1" ]; then
        dump_keys "$JSON_DATA"
    else
        parse_counters "$JSON_DATA"
        check_report
    fi
    exit 0
fi

# ---- single frame ---------------------------------------------------------------
[ -t 1 ] || ONCE=1
if [ "$ONCE" = "1" ]; then
    collect_cycle
    if [ "$SOCKET_STATUS" = "OK" ]; then
        sleep 2                # second sample gives the rates a baseline
        collect_cycle
    fi
    printf '%s\n' "$FRAME"
    exit 0
fi

# ---- interactive ---------------------------------------------------------------
INTERACTIVE=1
STTY_SAVE="$(stty -g 2>/dev/null || true)"
printf '\033[?1049h\033[?7l\033[?25l\033[2J'

while true; do
    collect_cycle
    draw
    wait_for_input
done
