    row "Avg pkt size:" "${DV[AVG_PKT]}" "$CYAN" "Max pkt size:" "${DV[MAX_PKT]}" "$CYAN" "Drop ratio:" "$(kernel_drop_percent)" "$YELLOW"

    section "FLOW & TCP"
