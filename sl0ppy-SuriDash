read -r -d '' JQ_COUNTERS <<'EOF'
def unwrap: if type == "object" and has("message") then .message else . end;
def leafsum:
    if type == "number" then .
    elif type == "string" then (tonumber? // null)
    elif type == "object" then
        ([.. | numbers] | if length > 0 then add else null end)
    else null end;
def wp($o; $p):
    if ($p | length) == 0 then ($o | leafsum)
    elif ($o | type) != "object" then null
    elif $p[0] == "*" then
        ([ $o[] | wp(.; $p[1:]) | select(. != null) ]
         | if length > 0 then add else null end)
    else wp($o[$p[0]]; $p[1:]) end;
def lookup($obj; $path):
    if ($obj | type) != "object" then null
    elif ($obj | has($path)) then ($obj[$path] | leafsum)
    else wp($obj; ($path | split("."))) end;
def lookup_sum($root; $expr):
    [ $expr | split("+") | .[] | lookup($root; .) | select(. != null) ]
    | if length > 0 then add else null end;
def val($root; $expr):
    if ($root | type) == "array" then
        [ $root[] | lookup_sum(.; $expr) | select(. != null) ]
        | if length > 0 then add else null end
    else lookup_sum($root; $expr) end;
unwrap as $root
| ($map | split(" ") | map(select(length > 0)) | .[]) as $pair
| ($pair | split(":")) as $kv
| ($kv[1] | split("|")) as $alts
| ([ $alts[] as $a | {a: $a, v: val($root; $a)} | select(.v != null) ] | .[0]) as $hit
| if $hit == null then "\($kv[0])=NA;-"
  else "\($kv[0])=\($hit.v | floor | tostring);\($hit.a)" end
EOF

read -r -d '' JQ_DUMP_KEYS <<'EOF'
def unwrap: if type == "object" and has("message") then .message else . end;
def flat(o; p):
    o | to_entries[] |
    if (.value | type) == "object" then flat(.value; p + .key + ".")
    elif (.value | type) == "number" then "\(p)\(.key)\t\(.value)"
    else empty end;
[ flat(unwrap; "") ] | sort | .[]
EOF

read -r -d '' JQ_FIND_RULES <<'EOF'
[ .. | objects | .rules_loaded? |
    if type == "number" then .
    elif type == "string" then tonumber?
    else null end ]
| map(select(. != null))
| if length > 0 then max else 0 end
EOF

read -r -d '' JQ_EVE_STREAM <<'EOF'
def san: tostring | gsub("[^ -~]"; "?");
def is_info:
    ((.alert.signature? // "") | tostring | test("^ET INFO"; "i"))
    or ((.alert.severity? // 3) >= 3)
    or (((.alert.metadata.signature_severity? // [])
         | if type == "array" then map(tostring | ascii_downcase)
           else [tostring | ascii_downcase] end)
        | index("informational") != null);
fromjson?
| select(type == "object")
| (.event_type? // "") as $t
| (if ($t == "alert" or has("alert")) then
      ["A",
       (.alert.severity? // 0),
       ((.src_ip? // .source_ip? // .src? // "?") | san),
       ((.dest_ip? // .destination_ip? // .dst? // "?") | san),
       ((.alert.signature? // .alert.signature_id? // .signature? // "?") | san),
       ((.alert.category? // "?") | san),
       (if is_info then "I" else "T" end)]
   elif $t == "http" then ["H", ((.http.hostname? // .http.host? // .hostname? // .host? // "") | san)]
   elif $t == "tls"  then ["T", ((.tls.sni? // .tls.server_name? // "") | san)]
   elif $t == "dns"  then ["D", ((.dns.rrname? // .dns.answers[0].rrname? // .dns.queries[0].rrname? // .dns.query? // .query? // "") | san)]
   else ["X", ($t | san)]
   end)
| @tsv
EOF

read -r -d '' AWK_EVE_AGG <<'EOF'
$1 == "A" {
    sev = $2 + 0
    if      (sev == 1) s1++
    else if (sev == 2) s2++
    else if (sev == 3) s3++
    else               s4++
    src = $3; dst = $4; sig = $5; cat = $6; cls = $7
    if (cls == "I") {
        a_info++
        if (sig != "?" && sig != "") c_isig[sig]++
        next
    }
    a_thr++
    if (src != "?" && src != "" && !(src in useen)) { useen[src]; nu_src++ }
    if (dst != "?" && dst != "" && !(dst in dseen)) { dseen[dst]; nu_dst++ }
    if (sig != "?" && sig != "" && !(sig in sseen)) { sseen[sig]; nu_sig++ }
    if (sig != "?" && sig != "") c_sig[sig]++
    if (src != "?" && src != "") c_src[src]++
    if (dst != "?" && dst != "") c_dst[dst]++
    if (cat != "?" && cat != "") c_cat[cat]++
    next
}
$1 == "H" { http++; if ($2 != "") c_http[$2]++; next }
$1 == "T" { tls++;  if ($2 != "") c_tls[$2]++;  next }
$1 == "D" { dns++;  if ($2 != "") c_dns[$2]++;  next }
{
    others++
    t = $2
    if (t ~ /anomal/) anomaly++
    if (t == "flow") flows++
}
END {
    total = others + a_thr + a_info + http + tls + dns
    printf "AGG %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f %.0f\n", \
        total, a_thr+0, a_info+0, nu_sig+0, nu_src+0, nu_dst+0, \
        s1+0, s2+0, s3+0, s4+0, anomaly+0, http+0, tls+0, dns+0, flows+0
    top("SIG",  c_sig,  8); top("SRC",  c_src,  8)
    top("DST",  c_dst,  8); top("CAT",  c_cat,  8)
    top("ISIG", c_isig, 8)
    top("HTTP", c_http, 8); top("TLS",  c_tls,  8)
    top("DNS",  c_dns,  8)
}
function top(tag, arr, m,   i, k, best, bestv) {
    for (i = 0; i < m; i++) {
        best = ""; bestv = 0
        for (k in arr)
            if (arr[k] > bestv) { bestv = arr[k]; best = k }
        if (best == "") break
        printf "%s\t%.0f\t%s\n", tag, bestv, best
        delete arr[best]
    }
}
EOF

