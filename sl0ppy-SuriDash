    if [ ! -f "$EVE_LOG" ]; then
        printf '  %s\n' "${YELLOW}EVE log not found: ${EVE_LOG}${NC}"
    fi
    printf "  ${WHITE}Events: ${CYAN}%-8d${NC}${WHITE}Threats: ${RED}%-7d${NC}${WHITE}Info: ${CYAN}%-8d${NC}${WHITE}Uniq sigs: ${CYAN}%-6d${NC}${WHITE}Uniq src: ${CYAN}%-6d${NC}${WHITE}Uniq dst: ${CYAN}%-6d${NC}\n" \
        "$EVE_EVENTS" "$EVE_THREATS" "$EVE_INFO" "$EVE_UNIQUE_SIGS" "$EVE_UNIQUE_SRC" "$EVE_UNIQUE_DST"
    printf "  ${WHITE}Sev1: ${RED}%-8d${NC}${WHITE}Sev2: ${YELLOW}%-10d${NC}${WHITE}Sev3: ${CYAN}%-8d${NC}${WHITE}Sev4/Info: ${CYAN}%-9d${NC}${WHITE}Anomalies: ${YELLOW}%-8d${NC}\n" \
        "$EVE_SEV1" "$EVE_SEV2" "$EVE_SEV3" "$EVE_SEV4" "$EVE_ANOMALY"
    printf "  ${WHITE}HTTP: ${CYAN}%-8d${NC}${WHITE}TLS: ${CYAN}%-11d${NC}${WHITE}DNS: ${CYAN}%-9d${NC}${WHITE}Flows: ${CYAN}%-11d${NC}${WHITE}EVE size: ${CYAN}%-10s${NC}\n" \
        "$EVE_HTTP" "$EVE_TLS" "$EVE_DNS" "$EVE_FLOWS" "$eve_size"
    printf '\n'

    printf '%s\n' "  ${RED}${BOLD}Top THREAT signatures (medium/high):${NC}"
    print_top_list "$TOP_SIGS" "(no medium/high threats in current EVE sample)"
    printf '%s\n' "  ${RED}${BOLD}Top THREAT sources:${NC}";       print_top_list "$TOP_SRC" "(none)"
    printf '%s\n' "  ${RED}${BOLD}Top THREAT destinations:${NC}";  print_top_list "$TOP_DST" "(none)"
    printf '%s\n' "  ${RED}${BOLD}Top THREAT categories:${NC}";    print_top_list "$TOP_CATS" "(none)"
    printf '\n'
    printf '%s\n' "  ${CYAN}${BOLD}Top ET INFORMATIONAL signatures:${NC}"
    print_top_list "$TOP_ISIGS" "(no informational alerts in current EVE sample)"
    printf '\n'
    printf '%s\n' "  ${BOLD}${WHITE}Top HTTP hosts:${NC}";  print_top_list "$TOP_HTTP"
    printf '%s\n' "  ${BOLD}${WHITE}Top TLS SNI:${NC}";     print_top_list "$TOP_TLS"
    printf '%s\n' "  ${BOLD}${WHITE}Top DNS names:${NC}";   print_top_list "$TOP_DNS"

    show_info_box
}

show_health() {
    local status="OK" status_color="$GREEN" ver
    set_health_color

    if [ "$SOCKET_STATUS" != "OK" ]; then
        status="SOCKET OFFLINE"; status_color="$RED"
    elif hp_active capture-drop; then
        status="CAPTURE DROPS"; status_color="$YELLOW"
    elif hp_active alert-queue-overflow; then
        status="ALERT QUEUE BUSY"; status_color="$YELLOW"
    elif [ "$HEALTH_PCT" -lt 90 ]; then
        status="DEGRADED"; status_color="$YELLOW"
    fi
    ver="${SURICATA_VERSION:0:14}"

    section "SENSOR HEALTH"
    row "Health:" "${HEALTH_PCT}% $status" "$HC${BOLD}" \
        "Socket:" "$SOCKET_STATUS" "$CYAN" \
        "Rate source:" "${RATE_SRC:0:14}" "$DIM"
    row "Suricata:" "$ver" "$CYAN" \
        "Alert queue:" "${DV[DETECT_QUEUE]}" "$CYAN" \
        "Alert/pkt:" "$(alert_ratio)" "$CYAN"
    row "Uptime:" "$(fmt_uptime "$UPTIME")" "$CYAN" \
        "Flows active:" "${DV[ACTIVE_FLOWS]}" "$CYAN" \
        "Total alerts:" "${DV[ALERTS]}" "$CYAN"
    if [ -n "$HEALTH_REASONS" ]; then
        printf '  %s%-16s %s%s%s\n' "$WHITE" "Reasons:" "$YELLOW" "$HEALTH_REASONS" "$NC"
    else
        printf '  %s%-16s %s%s%s\n' "$WHITE" "Reasons:" "$GREEN" "none - all systems nominal" "$NC"
    fi
    row "Flow memcap:" "${DV[FLOW_MEMCAP]}" "$YELLOW" \
        "Flow mem use:" "${DV[FLOW_MEM_USE]}" "$CYAN" \
        "Flow emerg.:" "${DV[FLOW_EMERGENCY]}" "$YELLOW"
    row "Frag memcap:" "${DV[FRAG_MEMCAP]}" "$CYAN" \
        "Frag mem use:" "${DV[FRAG_MEM_USE]}" "$CYAN" \
        "App-layer err:" "${DV[AL_ERR]}" "$CYAN"
    row "Drop ratio:" "$(kernel_drop_percent)" "$YELLOW" \
        "Last drop %:" "${DROP_PCT_NOW}%" "$YELLOW" \
        "Resets:" "$COUNTER_RESETS" "$CYAN"
    row "Load:" "$LOAD_LABEL" "$CYAN" \
        "Refresh:" "${REFRESH_INTERVAL}s" "$CYAN" \
        "Health hold:" "${HEALTH_HOLD_S}s" "$CYAN"
}

# ------------------------------------------------------------------------------
