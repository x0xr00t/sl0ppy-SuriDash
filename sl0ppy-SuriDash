# ------------------------------------------------------------------------------
# COUNTER PARSING  (also feeds the per-counter delta engine)
# ------------------------------------------------------------------------------
parse_counters() {
    local line k rest v alt prev
    STATS_RESOLVED=0; STATS_NA=0
    while IFS= read -r line; do
        k="${line%%=*}"
        rest="${line#*=}"
        v="${rest%%;*}"
        alt="${rest#*;}"
        [[ "$k" =~ ^[A-Z0-9_]+$ ]] || continue

        if [ "$v" = "NA" ]; then
            # Not exposed by this build: show n/a, keep numeric value at 0.
            DV[$k]="n/a"; CTR_ALT[$k]="-"; DELTA[$k]=""
            STATS_NA=$(( STATS_NA + 1 ))
            continue
        fi
        if ! [[ "$v" =~ ^-?[0-9]+$ ]]; then
            if [[ "$v" =~ ^-?[0-9.]+([eE][+-]?[0-9]+)?$ ]]; then
                v="$(awk -v x="$v" 'BEGIN { printf "%.0f", x }')"
            else
                continue
            fi
        fi
        printf -v "$k" '%s' "$v"
        CTR_ALT[$k]="$alt"

        # Delta engine: "+N" only when the snapshot value genuinely grew.
        # Repeated identical snapshots produce no delta; a reset (v < prev)
        # is not shown as a negative delta, PREV just re-anchors.
        prev="${PREV_VAL[$k]:-}"
        if [ -n "$prev" ] && [ "$v" -gt "$prev" ]; then
            DELTA[$k]=$(( v - prev ))
        else
            DELTA[$k]=""
        fi
        PREV_VAL[$k]="$v"

        case "$k" in
            FLOW_MEM_USE|FRAG_MEM_USE|TCP_MEMUSE|TCP_REASM_MEM) bytes_h "$v" ;;
            *) num_commas "$v" ;;
        esac
        DV[$k]="$FMT_OUT"
        STATS_RESOLVED=$(( STATS_RESOLVED + 1 ))
    done < <(printf '%s\n' "$1" | jq -r --arg map "$MAP_STR" "$JQ_COUNTERS" 2>/dev/null)
    if [ "$STATS_RESOLVED" -eq 0 ]; then
        STATS_WARN=1
    else
        STATS_WARN=0
    fi
}

