        PKT_SRC="proto-sum"
    fi

    if [ "${BYTES:-0}" -gt 0 ]; then
        EFF_BYTES="$BYTES"; BYTE_SRC="decoder.bytes"
    else
        EFF_BYTES=0; BYTE_SRC="none"
    fi

    if [ "${TOTAL_FLOWS:-0}" -gt 0 ]; then
