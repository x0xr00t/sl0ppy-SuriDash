# ------------------------------------------------------------------------------
show_connection_error() {
    local rule
    printf -v rule '%*s' "$TERM_W" ''; rule="${rule// /=}"
    printf '%s\n' "${RED}${BOLD}${rule}${NC}"
    printf '%s\n' "${RED}${BOLD}               SURICATA IPS DASHBOARD [CRITICAL ERROR]${NC}"
    printf '%s\n' "${RED}${BOLD}${rule}${NC}"
    printf '%s\n' "${YELLOW}[!] Unable to connect to the Suricata socket.${NC}"
    printf '%s\n' "    Make sure Suricata is running in IPS/IDS mode with the unix-command socket enabled."
    printf '%s\n' "    Socket status: ${WHITE}${SOCKET_STATUS:-UNKNOWN}${NC}"
    if [ -n "${SOCKET:-}" ]; then
        printf '%s\n' "    Socket path:   ${WHITE}${SOCKET}${NC}"
    else
        printf '%s\n' "    Socket path:   ${WHITE}default / auto-discovery${NC}"
    fi
    printf '%s\n' "----------------------------------------------------------------------"
    printf '%s\n' "${CYAN}[+] Diagnostics:${NC}"
    printf '%s\n' "  1. sudo systemctl status suricata --no-pager"
    printf '%s\n' "  2. sudo suricatasc -c version"
    printf '%s\n' "  3. sudo find /run /var/run -type s -iname '*suricata*' 2>/dev/null"
    printf '%s\n' "  4. sudo ls -lh ${EVE_LOG}"
    printf '%s\n' "  5. sudo journalctl -u suricata -n 50 --no-pager"
    printf '%s\n' "----------------------------------------------------------------------"
    printf '%s\n' "${CYAN}[+] Realtime Fast-Log Audit (last 10 alerts):${NC}"
    if [ -f "$FAST_LOG" ]; then
        tail -n 10 "$FAST_LOG" | sed -e 's/\x1b\[[0-9;]*m//g' | tr -cd '\11\12\15\40-\176'
    else
        printf '%s\n' "${RED}[-] No fast.log found at $FAST_LOG${NC}"
    fi
}

# ------------------------------------------------------------------------------
# FRAME RENDERING
# ------------------------------------------------------------------------------
render_frame() {
    local rule rule_dash title pad_l pad_r pkt_bar mb_bar pk_peak mb_peak
    local status_txt rules_txt bw_ok=1 mbit_disp eff_pk eff_by
    local inspect="OK"

    set_health_color
    printf -v rule '%*s' "$TERM_W" ''
    rule_dash="${rule// /-}"
    rule="${rule// /=}"

    title="sl0ppy SURICATA HARDENED IPS DASHBOARD"
    pad_l=$(( (TERM_W - ${#title}) / 2 ))
    pad_r=$(( TERM_W - ${#title} - pad_l ))

    [ "$SOCKET_STATUS" = "OK" ] && status_txt="ACTIVE" || status_txt="OFFLINE"
    if [ "$RULES_LOADED" -gt 0 ]; then rules_txt="$RULES_LOADED"; else rules_txt="n/a"; fi
    [ "$HEALTH_PCT" -ge 90 ] || inspect="CHECK"
    pk_peak="$(hund "$PEAK")"; mb_peak="$(hund "$PEAK_MB")"
    num_commas "$EFF_PKTS"; eff_pk="$FMT_OUT"
    if [ "$BYTE_SRC" = "none" ]; then eff_by="n/a"; else bytes_h "$EFF_BYTES"; eff_by="$FMT_OUT"; fi
    if [ "$BYTE_SRC" = "none" ] && [ "$NIC_OK" -eq 0 ]; then bw_ok=0; fi
    if [ "$bw_ok" -eq 1 ]; then mbit_disp="$MBIT_RATE"; else mbit_disp="n/a"; fi

    printf '%s\n' "${BLUE}${BOLD}${rule}${NC}"
    printf '%s%*s%s%*s%s\n' "${BG_BLUE}${WHITE}${BOLD}" "$pad_l" "" "$title" "$pad_r" "" "$NC"
    printf '%s\n' "${BLUE}${BOLD}${rule}${NC}"

    row "Status:" "$status_txt" "$GREEN" \
        "Uptime:" "$(fmt_uptime "$UPTIME")" "$CYAN" \
        "Rules active:" "$rules_txt" "$YELLOW"
    row "Pps:" "$PKT_RATE" "$GREEN" \
        "Mbit/s:" "$mbit_disp" "$CYAN" \
        "Drops/s:" "$DROP_RATE" "$YELLOW"
    row "Health:" "${HEALTH_PCT}%" "$HC${BOLD}" \
        "Peak pps:" "$pk_peak" "$CYAN" \
        "Peak Mbit/s:" "$mb_peak" "$CYAN"
    row "Alerts/s:" "$ALERT_RATE" "$RED" \
        "New flows/s:" "$FLOW_RATE" "$CYAN" \
        "Rate source:" "${RATE_SRC:0:14}" "$DIM"
    row "Suricata:" "${SURICATA_VERSION:0:14}" "$CYAN" \
        "Suridash:" "$Suridash_Version" "$CYAN" \
        "Refresh:" "${REFRESH_INTERVAL}s" "$CYAN"
    printf '%s\n' "${BLUE}${BOLD}${rule_dash}${NC}"

    # ---- Traffic graphs (auto-scaling bars) ----
    pkt_bar=$(( 10#${PKT_RATE/./} ))
    printf '%s\n' "${WHITE}  Packet rate (auto-scale, peak: ${pk_peak} pps):${NC}"
    printf '  %s%s%s  %s%s pps%s\n' "$GREEN" "$(make_graph "$pkt_bar" "$PEAK")" "$NC" "$CYAN" "$PKT_RATE" "$NC"
    if [ "$bw_ok" -eq 0 ]; then
        printf '%s\n' "${WHITE}  Bandwidth:${NC} ${DIM}no byte counter available (Suricata decoder.bytes / NIC)${NC}"
    else
        mb_bar=$(( 10#${MBIT_RATE/./} ))
        printf '%s\n' "${WHITE}  Bandwidth (auto-scale, peak: ${mb_peak} Mbit/s):${NC}"
        printf '  %s%s%s  %s%s Mbit/s%s\n' "$YELLOW" "$(make_graph "$mb_bar" "$PEAK_MB")" "$NC" "$CYAN" "$MBIT_RATE" "$NC"
    fi

    section "DECODER & CAPTURE"
    row "Packets:" "$eff_pk" "$CYAN" "Bytes:" "$eff_by" "$CYAN" "Invalid:" "${DV[DEC_INVALID]}" "$YELLOW"
    row "IPv4:" "${DV[IPV4_PKTS]}" "$CYAN" "IPv6:" "${DV[IPV6_PKTS]}" "$CYAN" "ARP:" "${DV[ARP_PKTS]}" "$CYAN"
    row "TCP pkts:" "${DV[TCP_PKTS]}" "$CYAN" "UDP pkts:" "${DV[UDP_PKTS]}" "$CYAN" "ICMP pkts:" "${DV[ICMP_PKTS]}" "$CYAN"
    row "Kernel pkts:" "${DV[KERNEL_PKTS]}" "$CYAN" "Kernel drops:" "${DV[KERNEL_DROPS]}" "$YELLOW" "IF drops:" "${DV[KERNEL_IFDROPS]}" "$YELLOW"
    row "Avg pkt size:" "${DV[AVG_PKT]}" "$CYAN" "Max pkt size:" "${DV[MAX_PKT]}" "$CYAN" "Drop ratio:" "$(kernel_drop_percent)" "$YELLOW"

