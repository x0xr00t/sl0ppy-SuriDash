# COLORS & STYLING (real escape characters: safe for printf '%s')
# ------------------------------------------------------------------------------
NC=$'\e[0m'; BOLD=$'\e[1m'; DIM=$'\e[2m'; REV=$'\e[7m'
WHITE=$'\e[97m'; BLUE=$'\e[34m'; GREEN=$'\e[32m'; RED=$'\e[31m'
YELLOW=$'\e[33m'; CYAN=$'\e[36m'; MAGENTA=$'\e[35m'
BG_BLUE=$'\e[44m'

# ------------------------------------------------------------------------------
# CONFIGURATION (all overridable through environment variables)
# ------------------------------------------------------------------------------
