    row "SSN drop:" "${DV[MEMCAP_DROPS]}" "$YELLOW" "Segment drop:" "${DV[SEG_MEMCAP]}" "$YELLOW" "Seg. cache:" "${DV[SEG_CACHE]}" "$CYAN"
