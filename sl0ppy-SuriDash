    row "UDP flows:" "${DV[F_UDP]}" "$CYAN" "ICMPv4 flows:" "${DV[F_ICMP4]}" "$CYAN" "ICMPv6 flows:" "${DV[F_ICMP6]}" "$CYAN"
    row "Ended new:" "${DV[END_NEW]}" "$CYAN" "Ended est.:" "${DV[END_EST]}" "$CYAN" "Ended closed:" "${DV[END_CLOSED]}" "$CYAN"
    row "Flow memcap:" "${DV[FLOW_MEMCAP]}" "$YELLOW" "Flow emerg.:" "${DV[FLOW_EMERGENCY]}" "$YELLOW" "Wrong thread:" "${DV[FLOW_WRONG_THR]}" "$YELLOW"
